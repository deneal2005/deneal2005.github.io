# Copy to .env (git-ignored) and fill in what you need. Everything is optional.

# Full URL the site is deployed at. Enables canonical URLs, absolute
# Open Graph image URLs and the sitemap.
PUBLIC_SITE_URL=

# Public contact email. Overrides profile.links.email in src/data/profile.ts.
PUBLIC_CONTACT_EMAIL=

# Optional GitHub token (no scopes needed for public data). Only raises the
# API rate limit for build-time repository data; it is never sent to the browser.
GITHUB_TOKEN=

# Set to true to build without calling the GitHub API (offline builds).
GITHUB_OFFLINE=false
