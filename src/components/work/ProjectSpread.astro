---
/**
 * One expedition in Sector 04. Each project chooses one of five compositions
 * (`layout` in its frontmatter), so the sequence reads like a set of mission
 * briefings rather than a grid of cards.
 */
import type { CollectionEntry } from 'astro:content';
import Plate from '../ui/Plate.astro';
import Arrow from '../ui/Arrow.astro';
import { plates, plateSize, plateUrl } from '../../lib/plates';

interface Props {
  work: CollectionEntry<'work'>;
}

const { work } = Astro.props;
const { data } = work;
const number = String(data.order).padStart(2, '0');
const size = plateSize(plates[data.plate], 'a');
const src = plateUrl(data.plate, 'a');
// The wide spread crops its plate to a cinematic letterbox.
const ratio = data.layout === 'wide' ? '21 / 9' : undefined;
---

<article class:list={['spread', `spread--${data.layout}`]} data-cursor="Report">
  <Plate
    class="spread__plate"
    src={src}
    alt={data.alt}
    width={size.width}
    height={size.height}
    ratio={ratio}
    transitionName={`plate-${work.id}`}
  />

  <div class="spread__text">
    <p class="spread__index meta">
      <span class="spread__no">Expedition {number}</span>
      <span class="spread__ja" lang="ja">遠征{number}</span>
      <span class="spread__rule" aria-hidden="true"></span>
      <span>{data.kind}</span>
      <span aria-hidden="true">·</span>
      <span>{data.year}</span>
      <span class="spread__status">{data.status}</span>
    </p>

    <h3 class="spread__title display" data-reveal="rise">
      <a class="spread__link" href={`/work/${work.id}/`} data-astro-prefetch>
        {
          data.titleLines.map((line, i) => (
            <span class="rise" style={`--line: ${i}`}>
              <span>{line}</span>
            </span>
          ))
        }
      </a>
    </h3>

    <div class="spread__body">
      <p class="spread__logline">{data.summary}</p>
      <p class="spread__disciplines meta">{data.stack.slice(0, 4).join(' / ')}</p>
      <p class="spread__cta meta" aria-hidden="true">
        Read the expedition report
        <Arrow />
      </p>
    </div>
  </div>
</article>

<style>
  .spread {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
  }

  /* The title link stretches over the whole spread: one target, one accessible name. */
  .spread__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .spread__link:focus-visible {
    outline: none;
  }

  .spread:has(.spread__link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 8px;
  }

  .spread__index {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text);
  }

  .spread__index > span {
    white-space: nowrap;
  }

  .spread__no {
    font-weight: 500;
    color: var(--color-accent-text);
  }

  .spread__ja {
    font-family: var(--type-jp);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .spread__status {
    margin-left: var(--space-2);
    padding: 0.15rem 0.45rem;
    background: var(--red);
    color: var(--bone);
  }

  .spread__rule {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }

  .spread__title {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 0.86;
    text-transform: uppercase;
  }

  .spread__body {
    margin-top: var(--space-5);
  }

  .spread__disciplines {
    margin-top: var(--space-4);
  }

  .spread__logline {
    max-width: 24rem;
    font-size: var(--text-m);
    line-height: 1.4;
    color: rgb(235 229 216 / 0.86);
  }

  .spread__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    color: var(--color-text);
  }

  /* ── Hover: the plate leans in; target brackets close on it ── */
  .spread :global(.spread__plate)::after {
    content: '';
    position: absolute;
    inset: 1rem;
    --c: var(--red);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / 2rem 2px,
      linear-gradient(var(--c), var(--c)) 0 0 / 2px 2rem,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2rem 2px,
      linear-gradient(var(--c), var(--c)) 100% 0 / 2px 2rem,
      linear-gradient(var(--c), var(--c)) 0 100% / 2rem 2px,
      linear-gradient(var(--c), var(--c)) 0 100% / 2px 2rem,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2rem 2px,
      linear-gradient(var(--c), var(--c)) 100% 100% / 2px 2rem;
    background-repeat: no-repeat;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 400ms var(--ease-out),
      transform 650ms var(--ease-out);
    pointer-events: none;
  }

  @media (hover: hover) {
    .spread:hover :global(.spread__plate img) {
      scale: 1.035;
    }

    .spread:hover :global(.spread__plate)::after {
      opacity: 1;
      transform: none;
    }

    .spread:hover .spread__cta .arrow {
      transform: translateX(0.4rem);
    }
  }

  /* ── Compositions (desktop) ──────────────────────────── */
  @media (min-width: 64rem) {
    /* right: tall plate on the right, title cutting into it */
    .spread--right :global(.spread__plate) {
      grid-column: 6 / -1;
      grid-row: 1;
    }

    .spread--right .spread__text {
      grid-column: 1 / 6;
      grid-row: 1;
      position: relative;
      z-index: 1;
      padding-bottom: var(--space-6);
    }

    .spread--right .spread__title {
      margin-right: -60%;
      font-size: clamp(4rem, 2rem + 6vw, 8.5rem);
    }

    /* wide: letterboxed plate bleeding to both edges, text in three columns beneath */
    .spread--wide :global(.spread__plate) {
      grid-column: 1 / -1;
      margin-inline: calc(var(--margin) * -1);
    }

    .spread--wide .spread__text {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: start;
      margin-top: var(--space-6);
    }

    .spread--wide .spread__index {
      grid-column: 1 / 4;
      margin-top: 0.6em;
    }

    .spread--wide .spread__title {
      grid-column: 4 / 9;
      margin-top: 0;
    }

    .spread--wide .spread__body {
      grid-column: 9 / -1;
      margin-top: 0.4em;
    }

    /* left: square plate, text set against it on the right */
    .spread--left :global(.spread__plate) {
      grid-column: 1 / 7;
    }

    .spread--left .spread__text {
      grid-column: 8 / -1;
      align-self: center;
    }

    /* offset: wide plate pushed right; the text sits in a caption box over its corner */
    .spread--offset :global(.spread__plate) {
      grid-column: 3 / -1;
      grid-row: 1;
    }

    .spread--offset .spread__text {
      grid-column: 1 / 7;
      grid-row: 2;
      position: relative;
      z-index: 1;
      margin-top: calc(var(--space-10) * -1);
      padding: var(--space-5) var(--space-6) var(--space-6);
      background: var(--color-bg);
      border: var(--panel-border) solid var(--color-rule-strong);
    }

    /* center: plate in the middle, title set down the spine */
    .spread--center {
      align-items: stretch;
    }

    .spread--center :global(.spread__plate) {
      grid-column: 4 / 10;
      grid-row: 1 / 3;
    }

    .spread--center .spread__text {
      display: contents;
    }

    .spread--center .spread__index {
      grid-column: 1 / 4;
      grid-row: 1;
      align-self: start;
    }

    .spread--center .spread__title {
      grid-column: 10 / -1;
      grid-row: 1 / 3;
      justify-self: center;
      margin-top: 0;
      writing-mode: vertical-rl;
      font-size: clamp(4rem, 2rem + 5.4vw, 8rem);
    }

    .spread--center .spread__title .rise {
      padding-inline: 0.06em 0.1em;
    }

    .spread--center .spread__body {
      grid-column: 1 / 4;
      grid-row: 2;
      align-self: end;
    }
  }

  /* ── Small screens: one column, plate first, each spread its own page ── */
  @media (max-width: 63.99rem) {
    .spread {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .spread :global(.spread__plate) {
      margin-inline: calc(var(--margin) * -1);
    }

    .spread--left :global(.spread__plate),
    .spread--center :global(.spread__plate) {
      margin-inline: 0;
      width: 82%;
    }

    .spread--center :global(.spread__plate) {
      align-self: flex-end;
    }

    .spread__text {
      margin-top: var(--space-5);
    }
  }
</style>
