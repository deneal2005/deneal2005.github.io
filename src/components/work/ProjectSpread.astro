---
/**
 * One expedition in Sector 04, presented as an operation file: a recon image
 * on one side (a real screenshot when the project has one, its drawn plate
 * otherwise) and a briefing on the other. Files alternate sides on desktop and
 * stack on phones. Every action is its own link, sized for touch.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Plate from '../ui/Plate.astro';
import Arrow from '../ui/Arrow.astro';
import { plates, plateSize, plateUrl } from '../../lib/plates';

interface Props {
  work: CollectionEntry<'work'>;
}

const { work } = Astro.props;
const { data } = work;
const number = String(data.order).padStart(2, '0');
const flip = data.order % 2 === 0;
const report = `/work/${work.id}/`;

// Recon imagery: the first landscape screenshot leads; a portrait one (a phone) rides on top of it.
const wide = data.screens.find((s) => s.src.width >= s.src.height);
const phone = data.screens.find((s) => s.src.height > s.src.width);
const plate = { src: plateUrl(data.plate, 'a'), ...plateSize(plates[data.plate], 'a') };

const loadout = data.stack.slice(0, 6);
const more = data.stack.length - loadout.length;
const capabilities = data.features.slice(0, 3);
---

<article class:list={['op', { 'op--flip': flip }]} aria-labelledby={`op-${work.id}`} data-reveal="fade">
  <!-- Recon image -->
  <figure class="op__recon">
    <div class="op__frame">
      {
        wide ? (
          <Image
            class="op__shot"
            src={wide.src}
            alt={wide.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 64rem) 58vw, 100vw"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Plate class="op__plate" src={plate.src} alt={data.alt} width={plate.width} height={plate.height} ratio="16 / 10" reveal={false} />
        )
      }
      {
        wide && phone && (
          <Image class="op__phone" src={phone.src} alt={phone.alt} widths={[200, 320, 480]} sizes="(min-width: 64rem) 12vw, 26vw" loading="lazy" decoding="async" />
        )
      }
      <span class="op__corner op__corner--tl" aria-hidden="true"></span>
      <span class="op__corner op__corner--tr" aria-hidden="true"></span>
      <span class="op__corner op__corner--bl" aria-hidden="true"></span>
      <span class="op__corner op__corner--br" aria-hidden="true"></span>
      <span class="op__rec meta" aria-hidden="true"><span class="op__rec-dot"></span>Recon · {number}</span>
    </div>
    <figcaption class="op__caption meta">
      {wide ? (wide.caption ?? 'Screenshot') : 'Plate drawn in code'}
      {data.screens.length > 0 && <span> · {data.screens.length} images in the report</span>}
    </figcaption>
  </figure>

  <!-- Briefing -->
  <div class="op__brief">
    <p class="op__strip meta">
      <span>Operation {number}</span>
      <span class="op__jp" lang="ja">作戦<span class="op__num">{number}</span></span>
      <span class:list={['op__status', { 'is-live': data.status === 'Live' }]}>
        <span class="op__status-dot" aria-hidden="true"></span>{data.status}
      </span>
    </p>

    <h3 class="op__title" id={`op-${work.id}`}>
      <a href={report} data-astro-prefetch>
        {data.titleLines.map((line) => <span>{line}</span>)}
      </a>
    </h3>
    <p class="op__kind meta">{[data.kind, data.year, data.role].filter(Boolean).join(' · ')}</p>

    <div class="op__block">
      <p class="op__label meta"><span lang="ja" class="op__jp">目的</span> Objective</p>
      <p class="op__objective">{data.summary}</p>
    </div>

    {
      capabilities.length > 0 && (
        <div class="op__block">
          <p class="op__label meta"><span lang="ja" class="op__jp">能力</span> Capabilities</p>
          <ul class="op__caps">
            {capabilities.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="op__block">
      <p class="op__label meta"><span lang="ja" class="op__jp">装備</span> Loadout</p>
      <ul class="op__loadout" aria-label="Technologies">
        {loadout.map((t) => <li>{t}</li>)}
        {more > 0 && <li class="op__more">+{more} more</li>}
      </ul>
    </div>

    <div class="op__actions">
      <a class="btn btn--ink" href={report} data-astro-prefetch data-magnetic="0.15">
        Read the mission report <Arrow />
        <span class="vh">: {data.title}</span>
      </a>
      {
        data.links.live && (
          <a class="btn" href={data.links.live} target="_blank" rel="noopener">
            Live site <Arrow dir="out" />
            <span class="vh">: {data.title} (opens in a new tab)</span>
          </a>
        )
      }
      {
        data.links.repo && (
          <a class="btn" href={data.links.repo} target="_blank" rel="noopener">
            Source <Arrow dir="out" />
            <span class="vh">: {data.title} on GitHub (opens in a new tab)</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .op {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-6);
    align-items: center;
  }

  /* ── Recon image ──────────────────────────────────── */
  .op__recon {
    grid-column: 1 / span 7;
  }

  .op__brief {
    grid-column: 8 / -1;
  }

  .op--flip .op__recon {
    grid-column: 6 / -1;
    grid-row: 1;
  }

  .op--flip .op__brief {
    grid-column: 1 / span 5;
    grid-row: 1;
  }

  .op__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    padding: clamp(0.5rem, 1.2vw, 1rem);
    border: 1px solid var(--color-rule-strong);
    background:
      linear-gradient(rgb(235 229 216 / 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgb(235 229 216 / 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--char);
  }

  .op__frame :global(.op__shot),
  .op__frame :global(.op__plate) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(0.85) contrast(1.02);
    transition:
      transform 1.2s var(--ease-out),
      filter var(--dur-3) var(--ease-out);
  }

  .op__frame :global(.op__plate) {
    aspect-ratio: auto;
  }

  /* A phone screenshot riding on the desktop one */
  .op__frame :global(.op__phone) {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 22%;
    height: auto;
    border: 4px solid var(--black);
    border-radius: 0.9rem;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.6);
    transition: transform 1.2s var(--ease-out);
  }

  .op__corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid var(--red);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .op__corner--tl {
    top: -1px;
    left: -1px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .op__corner--tr {
    top: -1px;
    right: -1px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .op__corner--bl {
    bottom: -1px;
    left: -1px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .op__corner--br {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .op__rec {
    position: absolute;
    top: calc(clamp(0.5rem, 1.2vw, 1rem) + 0.5rem);
    left: calc(clamp(0.5rem, 1.2vw, 1rem) + 0.5rem);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.25rem 0.5rem;
    background: rgb(12 11 10 / 0.8);
    color: var(--bone);
    font-size: 0.625rem;
  }

  .op__rec-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--red-light);
  }

  .op__caption {
    margin-top: var(--space-3);
  }

  /* ── Briefing ─────────────────────────────────────── */
  .op__strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--bone);
  }

  .op__jp {
    font-family: var(--type-jp);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .op__num {
    font-family: var(--type-mono);
    font-weight: 500;
    letter-spacing: 0;
  }

  .op__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    color: var(--gray);
  }

  .op__status.is-live {
    color: var(--red-light);
  }

  .op__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .op__status.is-live .op__status-dot {
      animation: beacon 2.4s ease-in-out infinite;
    }
  }

  @keyframes beacon {
    50% {
      opacity: 0.25;
    }
  }

  .op__title {
    margin-top: var(--space-5);
    font-family: var(--type-display);
    font-size: clamp(3rem, 1.8rem + 4.4vw, 6.25rem);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.84;
    text-transform: uppercase;
  }

  .op__title a {
    display: grid;
    transition: color var(--dur-2) var(--ease-out);
  }

  .op__kind {
    margin-top: var(--space-4);
  }

  .op__block {
    margin-top: var(--space-6);
  }

  .op__label {
    display: flex;
    gap: var(--space-2);
    color: var(--bone);
  }

  .op__objective {
    margin-top: var(--space-2);
    max-width: 30rem;
    font-size: var(--text-m);
    line-height: 1.45;
  }

  .op__caps {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    max-width: 30rem;
    font-size: var(--text-s);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .op__caps li {
    position: relative;
    padding-left: 1.25rem;
  }

  .op__caps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 2px;
    background: var(--red);
  }

  .op__loadout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .op__loadout li {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-rule-strong);
    font-family: var(--type-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--bone);
  }

  .op__loadout .op__more {
    border-style: dashed;
    color: var(--gray);
  }

  .op__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  /* ── Interaction: the recon image comes into focus; brackets close in ── */
  @media (hover: hover) {
    .op:hover .op__frame :global(.op__shot),
    .op:hover .op__frame :global(.op__plate) {
      transform: scale(1.025);
      filter: saturate(1) contrast(1.05);
    }

    .op:hover .op__frame :global(.op__phone) {
      transform: translateY(-0.6rem);
    }

    .op:hover .op__corner--tl {
      transform: translate(0.4rem, 0.4rem);
    }

    .op:hover .op__corner--tr {
      transform: translate(-0.4rem, 0.4rem);
    }

    .op:hover .op__corner--bl {
      transform: translate(0.4rem, -0.4rem);
    }

    .op:hover .op__corner--br {
      transform: translate(-0.4rem, -0.4rem);
    }

    .op__title a:hover {
      color: var(--red-light);
    }
  }

  /* ── Tablets and phones: one column, image first ───── */
  @media (max-width: 63.99rem) {
    .op,
    .op--flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .op__recon,
    .op__brief,
    .op--flip .op__recon,
    .op--flip .op__brief {
      grid-column: 1;
      grid-row: auto;
    }

    .op__brief {
      padding: var(--space-5);
      border: 1px solid var(--color-rule);
      background: rgb(31 29 27 / 0.45);
    }
  }

  @media (max-width: 47.99rem) {
    .op__frame :global(.op__phone) {
      width: 26%;
      right: 4%;
    }

    .op__brief {
      padding: var(--space-4);
    }

    .op__title {
      font-size: clamp(2.75rem, 16vw, 4rem);
    }

    /* Full-width actions: easy to hit with a thumb */
    .op__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .op__actions :global(.btn) {
      justify-content: space-between;
      min-height: 3rem;
    }
  }
</style>
