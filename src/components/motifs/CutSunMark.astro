---
/** The volume's mark: the sun, cut once. Shared by the masthead and the favicon. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path class="mark__half mark__half--a" d="M3.6 6.9 A10 10 0 0 1 19.7 18.1 Z"></path>
  <path class="mark__half mark__half--b" d="M3.6 6.9 A10 10 0 0 0 19.7 18.1 Z"></path>
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }

  .mark__half {
    fill: var(--shu);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .mark__half--a {
    transform: translate(0.7px, -1px);
  }

  .mark__half--b {
    transform: translate(-0.7px, 1px);
  }
</style>
