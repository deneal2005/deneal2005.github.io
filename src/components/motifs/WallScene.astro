---
/**
 * The opening scene when no reel is present: an original matte painting in
 * code. A colossal wall under a low, smoke-filled sky, lit from behind by a
 * buried sun. Each layer drifts at its own rate with the hero's scroll
 * progress (--p), so the camera still pushes in.
 */
// Buttresses widen toward the viewer on the left, so the wall recedes to the right.
const pilasters = Array.from({ length: 11 }, (_, i) => {
  const x = -20 + i * 168 - i * i * 1.6;
  const w = 46 - i * 2.4;
  const top = 418 - ((x + 60) * 34) / 1720; // flush with the parapet
  return `<path d="M${x.toFixed(1)} ${top.toFixed(1)}h${w.toFixed(1)}V900h-${w.toFixed(1)}Z"/><path class="wall__lit" d="M${(x + w).toFixed(1)} ${top.toFixed(1)}V900"/>`;
}).join('');
const courses = Array.from({ length: 9 }, (_, i) => {
  const y = 470 + i * i * 6 + i * 22;
  return `<path d="M-60 ${y - 34}L1660 ${y}"/>`;
}).join('');
---

<svg class="wall" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="wall-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0b0e10"></stop>
      <stop offset="0.55" stop-color="#1a2024"></stop>
      <stop offset="1" stop-color="#0d1011"></stop>
    </linearGradient>
    <radialGradient id="wall-sun" cx="1120" cy="430" r="520" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#d8bd8a" stop-opacity="0.75"></stop>
      <stop offset="0.18" stop-color="#c2a068" stop-opacity="0.4"></stop>
      <stop offset="0.45" stop-color="#8a6a40" stop-opacity="0.14"></stop>
      <stop offset="1" stop-color="#8a6a40" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="wall-face" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#20262a"></stop>
      <stop offset="0.5" stop-color="#101315"></stop>
      <stop offset="1" stop-color="#050606"></stop>
    </linearGradient>
    <linearGradient id="wall-fog" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#08090a" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#08090a"></stop>
    </linearGradient>
    <filter id="wall-blur" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="38"></feGaussianBlur>
    </filter>
  </defs>

  <g class="wall__sky">
    <rect x="-200" y="-200" width="2000" height="1300" fill="url(#wall-sky)"></rect>
    <rect x="-200" y="-200" width="2000" height="1300" fill="url(#wall-sun)"></rect>
  </g>

  <g class="wall__clouds" filter="url(#wall-blur)" fill="#2b3236" opacity="0.7">
    <ellipse cx="260" cy="210" rx="420" ry="90"></ellipse>
    <ellipse cx="980" cy="150" rx="520" ry="80"></ellipse>
    <ellipse cx="1420" cy="290" rx="360" ry="70"></ellipse>
    <ellipse cx="700" cy="330" rx="300" ry="50" fill="#3a3a33"></ellipse>
  </g>

  <g class="wall__face">
    <path d="M-60 410L1660 376V900H-60Z" fill="url(#wall-face)"></path>
    <g stroke="#262d31" stroke-width="1.5" fill="none" opacity="0.8">{/* courses of stone */}<Fragment set:html={courses} /></g>
    <g fill="#0b0d0e" stroke="none"><Fragment set:html={pilasters} /></g>
    <path d="M-60 418L1660 384" stroke="#2c3438" stroke-width="12" fill="none"></path>
    <path d="M-60 410L1660 376" stroke="#d8bd8a" stroke-opacity="0.55" stroke-width="1.5" fill="none"></path>
  </g>

  <g class="wall__smoke" filter="url(#wall-blur)" fill="#4a4d48" opacity="0.38">
    <ellipse cx="420" cy="380" rx="160" ry="120"></ellipse>
    <ellipse cx="520" cy="300" rx="120" ry="140"></ellipse>
    <ellipse cx="1240" cy="360" rx="200" ry="110"></ellipse>
    <ellipse cx="1320" cy="250" rx="140" ry="150"></ellipse>
  </g>

  <rect class="wall__fog" x="-200" y="540" width="2000" height="400" fill="url(#wall-fog)"></rect>
</svg>

<style>
  .wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .wall :global(.wall__lit) {
    fill: none;
    stroke: #2a3236;
    stroke-width: 1.5;
  }

  .wall g,
  .wall rect {
    transform-box: view-box;
    transform-origin: 50% 60%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wall__sky {
      transform: translateY(calc(var(--p, 0) * -2%));
    }

    .wall__clouds {
      transform: translateX(calc(var(--p, 0) * -6%));
    }

    .wall__face {
      transform: scale(calc(1.06 - var(--p, 0) * 0.06)) translateY(calc(var(--p, 0) * 5%));
    }

    .wall__smoke {
      transform: translate(calc(var(--p, 0) * 4%), calc(var(--p, 0) * -12%)) scale(calc(1 + var(--p, 0) * 0.4));
    }
  }
</style>
