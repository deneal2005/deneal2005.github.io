---
/**
 * The temper line. Used as the volume's divider: it draws itself once,
 * left to right, when it scrolls into view.
 */
import { hamonPath } from '../../lib/draw';

interface Props {
  seed?: number;
  tone?: 'ink' | 'shu';
  class?: string;
}

const { seed = 3, tone = 'ink', class: className } = Astro.props;
const width = 1600;
const height = 36;
const d = hamonPath({ width, height, seed });
---

<svg
  class:list={['hamon', `hamon--${tone}`, className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  data-draw
>
  <path class="hamon__mist" d={d}></path>
  <path class="hamon__line draw" d={d} pathLength="1"></path>
</svg>

<style>
  .hamon {
    width: 100%;
    height: 2.25rem;
    overflow: visible;
    fill: none;
  }

  .hamon__line {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* nioi: the soft frosted band either side of a real temper line */
  .hamon__mist {
    stroke: currentColor;
    stroke-width: 9;
    opacity: 0.07;
  }

  .hamon--shu {
    color: var(--shu);
  }
</style>
