---
/**
 * 目次 — the contents page. Replaces a conventional menu: chapters on the
 * left page, the five works on the right, with live page numbers.
 */
import { getCollection } from 'astro:content';
import { chapters } from '../../data/chapters';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<dialog id="contents" class="contents" aria-labelledby="contents-title" data-tone="ink">
  <div class="contents__inner">
    <div class="contents__head">
      <p class="contents__ja tate" lang="ja" aria-hidden="true">目次</p>
      <h2 id="contents-title" class="contents__title display">Contents</h2>
      <button class="btn contents__close" type="button" data-contents-close>
        Close
        <svg class="contents__x" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11"></path></svg>
      </button>
    </div>

    <nav class="contents__chapters" aria-label="Chapters">
      <ol>
        {
          chapters.map((chapter) => (
            <li>
              <a class="contents__row" href={`/#${chapter.id}`} data-contents-link>
                <span class="contents__label meta">{chapter.label}</span>
                <span class="contents__name">{chapter.title}</span>
                <span class="contents__leader" aria-hidden="true" />
                <span class="contents__kanji" lang="ja" aria-hidden="true">
                  {chapter.ja}
                </span>
                <span class="contents__page meta" data-page-for={chapter.id} />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <nav class="contents__works" aria-label="Selected work">
      <p class="meta">Inside Chapter 01</p>
      <ol>
        {
          works.map((work) => (
            <li>
              <a class="contents__work" href={`/work/${work.id}/`} data-contents-link data-astro-prefetch>
                <span class="meta">{String(work.data.order).padStart(2, '0')}</span>
                <span>{work.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</dialog>

<style>
  .contents {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 700ms var(--ease-in-out),
      display 700ms allow-discrete,
      overlay 700ms allow-discrete;
  }

  .contents[open] {
    clip-path: inset(0 0 0 0);
  }

  @starting-style {
    .contents[open] {
      clip-path: inset(0 0 100% 0);
    }
  }

  .contents::backdrop {
    background: transparent;
  }

  :global(html:has(.contents[open])) {
    overflow: hidden;
  }

  .contents__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    min-height: 100%;
    padding: var(--space-5) var(--margin) var(--space-8);
  }

  .contents__head {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contents__ja {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--shu);
  }

  .contents__title {
    font-size: var(--text-giga);
    font-style: italic;
    font-weight: 300;
    margin-top: -0.08em;
  }

  .contents__close {
    margin-left: auto;
  }

  .contents__x {
    width: 0.75rem;
    height: 0.75rem;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .contents__chapters {
    grid-column: 1 / span 8;
  }

  .contents__works {
    grid-column: 10 / -1;
    align-self: end;
  }

  .contents__row {
    display: grid;
    grid-template-columns: 8.5rem auto 1fr auto 3.5rem;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  li:last-child .contents__row {
    border-bottom: 1px solid var(--color-rule);
  }

  .contents__name {
    font-family: var(--type-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3.25rem);
    font-stretch: 75%;
    line-height: 1;
    transition: transform var(--dur-2) var(--ease-out), color var(--dur-1) linear;
  }

  .contents__leader {
    align-self: center;
    height: 1px;
    background-image: radial-gradient(circle, var(--color-text-muted) 0.8px, transparent 1.2px);
    background-size: 7px 2px;
    background-repeat: repeat-x;
    opacity: 0.6;
  }

  .contents__kanji {
    font-family: var(--type-jp);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .contents__page {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .contents__works ol {
    margin-top: var(--space-4);
  }

  .contents__work {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-2);
    font-size: var(--text-m);
    transition: color var(--dur-1) linear;
  }

  @media (hover: hover) {
    .contents__row:hover .contents__name {
      color: var(--shu-light);
      transform: translateX(0.4rem);
    }

    .contents__work:hover {
      color: var(--shu-light);
    }
  }

  @media (max-width: 63.99rem) {
    .contents__chapters,
    .contents__works {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .contents__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-7);
    }

    .contents__row {
      grid-template-columns: 1fr auto;
      row-gap: var(--space-1);
    }

    .contents__label {
      grid-column: 1 / -1;
    }

    .contents__leader,
    .contents__kanji {
      display: none;
    }

    .contents__ja {
      display: none;
    }
  }
</style>
