---
/**
 * The command bar: insignia and name, the sector navigation (the current
 * sector is marked in red as you scroll), the sound toggle and the operations
 * map. Below desktop width the sector list folds into the map.
 */
import Insignia from '../ui/Insignia.astro';
import { sections } from '../../data/sections';
import { site } from '../../data/site';
import { soundtrack } from '../../lib/media';

const onHome = Astro.url.pathname === '/';
---

<header class="masthead" data-masthead>
  <a class="masthead__brand" href="/" aria-label={`${site.name}, home`}>
    <Insignia size={24} />
    <span class="masthead__word masthead__word--full">{site.name}</span>
    <span class="masthead__word masthead__word--short" aria-hidden="true">{site.shortName}</span>
  </a>

  <nav class="mnav" aria-label="Sectors">
    <ol>
      {
        sections.map((s) => (
          <li>
            <a class="mnav__link" href={onHome ? `#${s.id}` : `/#${s.id}`} data-nav={s.id}>
              <span class="mnav__no">{s.no}</span>
              <span class="mnav__label">{s.nav}</span>
              <span class="mnav__ja" lang="ja" aria-hidden="true">
                {s.ja}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="masthead__end">
    {
      soundtrack && (
        <button class="masthead__sound" type="button" aria-pressed="false" data-sound={soundtrack}>
          <span class="masthead__eq" aria-hidden="true">
            <span />
            <span />
            <span />
            <span />
          </span>
          <span class="masthead__sound-label">Sound</span>
        </button>
      )
    }
    <button class="masthead__map" type="button" aria-haspopup="dialog" aria-controls="contents" data-contents-open>
      <span class="masthead__map-label">Map</span>
      <span class="masthead__ja" lang="ja" aria-hidden="true">作戦図</span>
    </button>
  </div>
</header>

<style>
  .masthead {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-masthead);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    height: var(--masthead-h);
    padding-inline: var(--margin);
    color: var(--bone);
    view-transition-name: masthead;
    transition:
      transform var(--dur-3) var(--ease-out),
      background-color var(--dur-2) linear,
      box-shadow var(--dur-2) linear;
  }

  .masthead[data-scrolled] {
    background-color: rgb(12 11 10 / 0.86);
    box-shadow: 0 1px 0 var(--color-rule);
  }

  /* Blur only where it's supported cheaply and only once scrolled */
  @supports (backdrop-filter: blur(1px)) {
    .masthead[data-scrolled] {
      background-color: rgb(12 11 10 / 0.7);
      backdrop-filter: blur(12px);
    }
  }

  .masthead[data-hidden] {
    transform: translateY(-100%);
  }

  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
  }

  .masthead__word {
    font-family: var(--type-sans);
    font-size: 0.85rem;
    font-stretch: 112%;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .masthead__word--short {
    display: none;
  }

  @media (hover: hover) {
    .masthead__brand:hover :global(.insignia__blade) {
      transform: translateY(-1.5px);
    }
  }

  /* ── Sector navigation ────────────────────────────── */
  .mnav {
    justify-self: center;
    display: none;
  }

  @media (min-width: 72rem) {
    .mnav {
      display: block;
    }
  }

  .mnav ol {
    display: flex;
    gap: var(--space-1);
  }

  .mnav__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.6rem;
    font-family: var(--type-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gray);
    transition: color var(--dur-2) var(--ease-out);
  }

  .mnav__link::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.45rem;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .mnav__no {
    color: var(--smoke);
    transition: color var(--dur-2) var(--ease-out);
  }

  .mnav__ja {
    font-family: var(--type-jp);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-size: 0.625rem;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .mnav__link[aria-current] {
    color: var(--bone);
  }

  .mnav__link[aria-current] .mnav__no {
    color: var(--red-light);
  }

  .mnav__link[aria-current] .mnav__ja {
    opacity: 1;
  }

  .mnav__link[aria-current]::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .mnav__link:hover {
      color: var(--bone);
    }

    .mnav__link:hover .mnav__ja {
      opacity: 1;
    }
  }

  /* ── End ──────────────────────────────────────────── */
  .masthead__end {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .masthead__sound,
  .masthead__map {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    font-family: var(--type-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .masthead__sound {
    color: var(--gray);
    transition: color var(--dur-2) linear;
  }

  .masthead__sound[aria-pressed='true'] {
    color: var(--red-light);
  }

  .masthead__eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.75rem;
  }

  .masthead__eq span {
    width: 2px;
    height: 2px;
    background: currentColor;
    transition: height var(--dur-2) var(--ease-out);
  }

  .masthead__sound[aria-pressed='true'] .masthead__eq span {
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .masthead__sound[aria-pressed='true'] .masthead__eq span {
      animation: eq 1.1s var(--ease-in-out) infinite alternate;
      transform-origin: bottom;
    }

    .masthead__eq span:nth-child(2) {
      animation-delay: -0.4s !important;
    }

    .masthead__eq span:nth-child(3) {
      animation-delay: -0.8s !important;
    }

    .masthead__eq span:nth-child(4) {
      animation-delay: -0.2s !important;
    }
  }

  @keyframes eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }

  .masthead__ja {
    font-family: var(--type-jp);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 0.3em 0.45em;
    color: var(--bone);
    background: var(--red);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) {
    .masthead__map:hover .masthead__ja {
      background: var(--red-deep);
    }
  }

  @media (max-width: 30rem) {
    .masthead__word--full {
      display: none;
    }

    .masthead__word--short {
      display: inline;
      letter-spacing: 0.16em;
    }

    .masthead__sound-label,
    .masthead__map-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .masthead__end {
      gap: var(--space-1);
    }
  }
</style>
