---
import CutSunMark from '../motifs/CutSunMark.astro';
import { site } from '../../data/site';
import { soundtrack } from '../../lib/media';

interface Props {
  /** Initial running head; the homepage updates it as chapters scroll past. */
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<header class="masthead" data-masthead data-tone-auto>
  <a class="masthead__brand" href="/" aria-label={`${site.name}, back to the first page`}>
    <CutSunMark size={20} />
    <span class="masthead__word masthead__word--full">{site.name}</span>
    <span class="masthead__word masthead__word--short" aria-hidden="true">{site.shortName}</span>
  </a>

  <p class="masthead__running meta" aria-hidden="true">
    <span data-running-label>{label}</span>
    <span class="masthead__rule"></span>
    <span class="masthead__title" data-running-title>{title}</span>
  </p>

  <div class="masthead__end">
    {
      soundtrack && (
        <button class="masthead__sound" type="button" aria-pressed="false" data-sound={soundtrack}>
          <span class="masthead__eq" aria-hidden="true"><span /><span /><span /><span /></span>
          <span class="masthead__sound-label">Sound</span>
        </button>
      )
    }
    <button class="masthead__contents" type="button" aria-haspopup="dialog" aria-controls="contents" data-contents-open>
      <span class="masthead__contents-label">Contents</span>
      <span class="masthead__ja" lang="ja" aria-hidden="true">目次</span>
    </button>
  </div>
</header>

<style>
  .masthead {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-masthead);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--masthead-h);
    padding-inline: var(--margin);
    color: var(--color-text);
    background-color: transparent;
    view-transition-name: masthead;
    transition:
      transform var(--dur-3) var(--ease-out),
      background-color var(--dur-2) linear,
      color var(--dur-2) linear,
      box-shadow var(--dur-2) linear;
  }

  .masthead[data-scrolled] {
    background-color: rgb(8 9 10 / 0.72);
    box-shadow: 0 1px 0 var(--color-rule);
    backdrop-filter: blur(16px) saturate(0.8);
  }

  .masthead[data-hidden] {
    transform: translateY(-100%);
  }

  .masthead__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
  }

  .masthead__word {
    font-family: var(--type-sans);
    font-size: 0.9rem;
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: 0.24em;
    margin-right: -0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .masthead__word--short {
    display: none;
  }

  @media (max-width: 30rem) {
    .masthead__word--full {
      display: none;
    }

    .masthead__word--short {
      display: inline;
      letter-spacing: 0.18em;
    }
  }

  /* Smallest phones: the seal alone is the button; "Contents" stays as its accessible name. */
  @media (max-width: 30rem) {
    .masthead__sound-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .masthead__end {
      gap: var(--space-2);
    }
  }

  @media (max-width: 26rem) {
    .masthead__contents-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .masthead__contents {
      margin-right: 0;
    }
  }

  @media (hover: hover) {
    .masthead__brand:hover :global(.mark__half--a) {
      transform: translate(2px, -2.8px);
    }

    .masthead__brand:hover :global(.mark__half--b) {
      transform: translate(-2px, 2.8px);
    }
  }

  .masthead__running {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .masthead__rule {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .masthead__title {
    color: var(--color-text-muted);
  }

  .masthead__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .masthead__sound {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    font-family: var(--type-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--dur-2) linear;
  }

  .masthead__sound[aria-pressed='true'] {
    color: var(--gold-light);
  }

  /* Four bars: flat when silent, moving when the soundtrack is on */
  .masthead__eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.75rem;
  }

  .masthead__eq span {
    width: 2px;
    height: 2px;
    background: currentColor;
    transition: height var(--dur-2) var(--ease-out);
  }

  .masthead__sound[aria-pressed='true'] .masthead__eq span {
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .masthead__sound[aria-pressed='true'] .masthead__eq span {
      animation: eq 1.1s var(--ease-in-out) infinite alternate;
    }

    .masthead__eq span:nth-child(2) { animation-delay: -0.4s !important; }
    .masthead__eq span:nth-child(3) { animation-delay: -0.8s !important; }
    .masthead__eq span:nth-child(4) { animation-delay: -0.2s !important; }
  }

  @keyframes eq {
    from { transform: scaleY(0.25); transform-origin: bottom; }
    to { transform: scaleY(1); transform-origin: bottom; }
  }

  .masthead__contents {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    margin-right: calc(var(--space-2) * -1);
    font-family: var(--type-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .masthead__ja {
    font-family: var(--type-jp);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    padding: 0.2em 0.4em;
    color: var(--gold-light);
    border: 1px solid var(--gold);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) {
    .masthead__contents:hover .masthead__ja {
      background-color: var(--gold);
      color: var(--void);
    }
  }

  /* The running head needs the full width; below laptop size the name and contents button share the bar. */
  @media (max-width: 63.99rem) {
    .masthead {
      grid-template-columns: 1fr auto;
    }

    .masthead__running {
      display: none;
    }
  }
</style>
