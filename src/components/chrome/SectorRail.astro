---
/**
 * Sector rail: the current sector's number and Japanese name, and a progress
 * spine for the whole page, set vertically in the right margin. Updated by
 * scripts/chrome.ts. Phones get a red hairline along the top edge instead.
 */
import { sections } from '../../data/sections';

const first = sections[0];
---

<div class="rail" data-rail aria-hidden="true">
  <span class="rail__label">Sector</span>
  <span class="rail__no" data-rail-no>{first.no}</span>
  <span class="rail__track"><span class="rail__fill" data-rail-fill></span></span>
  <span class="rail__ja" lang="ja" data-rail-ja>{first.ja}</span>
</div>

<span class="readbar" aria-hidden="true"><span class="readbar__fill" data-read-fill></span></span>

<style>
  .rail {
    position: fixed;
    top: 50%;
    right: calc(var(--margin) / 2 - 0.6rem);
    z-index: var(--z-masthead);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--bone);
    font-family: var(--type-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    transform: translateY(-50%);
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .rail {
      display: flex;
    }
  }

  .rail__label {
    writing-mode: vertical-rl;
    color: var(--gray);
  }

  .rail__no {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--red-light);
    font-variant-numeric: tabular-nums;
  }

  .rail__ja {
    writing-mode: vertical-rl;
    font-family: var(--type-jp);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  .rail__track {
    position: relative;
    width: 1px;
    height: 20vh;
    background: var(--color-rule-strong);
    overflow: hidden;
  }

  .rail__fill {
    position: absolute;
    inset: 0;
    background: var(--red);
    transform-origin: top;
    transform: scaleY(var(--progress, 0));
  }

  .readbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: calc(var(--z-masthead) + 1);
    height: 2px;
    pointer-events: none;
  }

  .readbar__fill {
    position: absolute;
    inset: 0;
    background: var(--red);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }

  @media (min-width: 64rem) {
    .readbar {
      display: none;
    }
  }
</style>
