---
/**
 * 作戦図 — the operations map. The full navigation: every sector with its
 * number and Japanese name, the expeditions, the campaign log and contact.
 * On phones it is the navigation.
 */
import ProfileLinks from '../ui/ProfileLinks.astro';
import { sections } from '../../data/sections';
import { getJourney, getWorks } from '../../lib/content';

const [works, journey] = await Promise.all([getWorks(), getJourney()]);
---

<dialog id="contents" class="ops" aria-labelledby="contents-title" data-tone="ink">
  <div class="ops__inner">
    <div class="ops__head">
      <p class="ops__ja" lang="ja" aria-hidden="true">作戦図</p>
      <h2 id="contents-title" class="ops__title">Operations map</h2>
      <button class="btn ops__close" type="button" data-contents-close>
        Close
        <svg class="ops__x" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11"></path></svg>
      </button>
    </div>

    <nav class="ops__sectors" aria-label="Sectors">
      <ol>
        {
          sections.map((s) => (
            <li>
              <a class="ops__row" href={`/#${s.id}`} data-contents-link data-nav={s.id}>
                <span class="ops__no">{s.no}</span>
                <span class="ops__name">{s.title}</span>
                <span class="ops__file meta">{s.file}</span>
                <span class="ops__kanji" lang="ja" aria-hidden="true">
                  {s.ja}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <nav class="ops__side" aria-label="Expeditions and records">
      <p class="meta">
        <span lang="ja" class="ops__jp">遠征</span> Expedition reports
      </p>
      <ol>
        {
          works.map((work) => (
            <li>
              <a class="ops__link" href={`/work/${work.id}/`} data-contents-link data-astro-prefetch>
                <span class="meta">{String(work.data.order).padStart(2, '0')}</span>
                <span>{work.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="meta ops__sub">
        <span lang="ja" class="ops__jp">戦歴</span> Records
      </p>
      <ol>
        <li>
          <a class="ops__link" href="/journey/" data-contents-link>
            <span class="meta">{String(journey.length).padStart(2, '0')}</span>
            <span>Campaign log</span>
          </a>
        </li>
      </ol>
      <ProfileLinks class="ops__links" />
    </nav>
  </div>
</dialog>

<style>
  .ops {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--bone);
    background: var(--void);
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 600ms var(--ease-in-out),
      display 600ms allow-discrete,
      overlay 600ms allow-discrete;
  }

  .ops[open] {
    clip-path: inset(0 0 0 0);
  }

  @starting-style {
    .ops[open] {
      clip-path: inset(0 0 100% 0);
    }
  }

  .ops::backdrop {
    background: transparent;
  }

  :global(html:has(.ops[open])) {
    overflow: hidden;
  }

  .ops__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    min-height: 100%;
    padding: var(--space-5) var(--margin) var(--space-8);
    /* Survey grid */
    background-image:
      linear-gradient(rgb(235 229 216 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(235 229 216 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .ops__head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .ops__ja {
    padding: 0.3em 0.45em;
    background: var(--red);
    font-family: var(--type-jp);
    font-weight: 900;
    font-size: clamp(1rem, 0.8rem + 0.6vw, 1.4rem);
    letter-spacing: 0.08em;
  }

  .ops__title {
    font-family: var(--type-display);
    font-stretch: 62%;
    font-weight: 900;
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .ops__close {
    margin-left: auto;
  }

  .ops__x {
    width: 0.75rem;
    height: 0.75rem;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .ops__sectors {
    grid-column: 1 / span 8;
  }

  .ops__side {
    grid-column: 10 / -1;
    align-self: end;
  }

  .ops__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 3rem;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  li:last-child .ops__row {
    border-bottom: 1px solid var(--color-rule);
  }

  .ops__no {
    font-family: var(--type-mono);
    font-size: var(--text-s);
    color: var(--red-light);
  }

  .ops__name {
    font-family: var(--type-display);
    font-stretch: 62%;
    font-weight: 800;
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3.4rem);
    line-height: 1;
    text-transform: uppercase;
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) linear;
  }

  .ops__kanji {
    font-family: var(--type-jp);
    font-weight: 700;
    color: var(--gray);
    text-align: right;
  }

  .ops__row[aria-current] .ops__name {
    color: var(--red-light);
  }

  .ops__jp {
    font-family: var(--type-jp);
    font-weight: 700;
    margin-right: var(--space-2);
    color: var(--bone);
  }

  .ops__side ol {
    margin-top: var(--space-4);
  }

  .ops__sub {
    margin-top: var(--space-6);
  }

  .ops__side :global(.ops__links) {
    margin-top: var(--space-5);
  }

  .ops__link {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-2);
    font-size: var(--text-m);
    transition: color var(--dur-1) linear;
  }

  @media (hover: hover) {
    .ops__row:hover .ops__name {
      color: var(--red-light);
      transform: translateX(0.4rem);
    }

    .ops__link:hover {
      color: var(--red-light);
    }
  }

  @media (max-width: 63.99rem) {
    .ops__sectors,
    .ops__side {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .ops__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-7);
    }

    .ops__row {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .ops__file {
      display: none;
    }
  }
</style>
