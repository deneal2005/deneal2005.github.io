---
/** 奥付 — the colophon a Japanese book carries on its last page. Every line is true. */
import HamonLine from '../motifs/HamonLine.astro';
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="colophon" data-tone="ink">
  <HamonLine seed={21} class="colophon__hamon" />
  <div class="colophon__grid grid">
    <p class="colophon__ja tate" lang="ja" aria-hidden="true">奥付</p>
    <h2 class="colophon__heading meta">Colophon</h2>
    <dl class="colophon__facts">
      <div>
        <dt class="meta">Title</dt>
        <dd>{site.brand}: Selected Works, {site.volume}</dd>
      </div>
      <div>
        <dt class="meta">Edition</dt>
        <dd>{site.edition}</dd>
      </div>
      <div>
        <dt class="meta">Type</dt>
        <dd>Noto Serif Display, Archivo, IBM Plex Mono and Shippori Mincho B1</dd>
      </div>
      <div>
        <dt class="meta">Plates</dt>
        <dd>Drawn in code and printed at build time. No stock imagery.</dd>
      </div>
      <div>
        <dt class="meta">Privacy</dt>
        <dd>No cookies, no trackers, nothing to accept.</dd>
      </div>
    </dl>
    <div class="colophon__end">
      <a class="link" href="/#top">Back to the first page</a>
      <p class="meta">© {year} {site.brand}. Every line is final.</p>
    </div>
  </div>
</footer>

<style>
  .colophon {
    padding: var(--space-8) var(--margin) var(--space-6);
  }

  .colophon :global(.colophon__hamon) {
    color: var(--usuzumi);
    margin-bottom: var(--space-8);
  }

  .colophon__grid {
    row-gap: var(--space-6);
    align-items: start;
  }

  .colophon__ja {
    grid-column: 1 / span 1;
    grid-row: 1 / span 2;
    font-size: 1.5rem;
    color: var(--shu);
  }

  .colophon__heading {
    grid-column: 2 / span 3;
    color: var(--color-text);
  }

  .colophon__facts {
    grid-column: 5 / span 6;
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-s);
  }

  .colophon__facts div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .colophon__facts dd {
    margin: 0;
  }

  .colophon__end {
    grid-column: 5 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--text-s);
  }

  @media (max-width: 47.99rem) {
    .colophon__ja {
      display: none;
    }

    .colophon__heading,
    .colophon__facts,
    .colophon__end {
      grid-column: 1 / -1;
    }

    .colophon__facts div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
