---
/** Contact marks, drawn to sit with the site's hairline arrow. */
import type { IconName } from '../../lib/links';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', `icon--${name}`, className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === 'linkedin' && (
      <path
        fill="currentColor"
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
      />
    )
  }
  {
    name === 'mail' && (
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
        <rect x="2.5" y="5" width="19" height="14" />
        <path d="M2.5 5.5l9.5 7.5 9.5-7.5" />
      </g>
    )
  }
  {
    name === 'phone' && (
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
        d="M8.2 3.5H4.6a1.1 1.1 0 0 0-1.1 1.2C4.2 13.3 10.7 19.8 19.3 20.5a1.1 1.1 0 0 0 1.2-1.1v-3.6l-4-1.6-2.1 2.1a12.2 12.2 0 0 1-6.7-6.7l2.1-2.1-1.6-4z"
      />
    )
  }
</svg>

<style>
  .icon {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
