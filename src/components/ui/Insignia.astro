---
/**
 * The site's insignia: a red field seal with a crenellated wall and an
 * upright blade. Original geometry; shared by the masthead and the favicon.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<svg class:list={['insignia', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect class="insignia__field" x="1" y="1" width="22" height="22" rx="1"></rect>
  <rect class="insignia__frame" x="3" y="3" width="18" height="18"></rect>
  <path class="insignia__wall" d="M5 19v-6h2v-1.6h2V13h2v-1.6h2V13h2v-1.6h2V13h2v6z"></path>
  <path class="insignia__blade" d="M12 4.2l.9 1.6v8.4h-1.8V5.8z M9.6 14.2h4.8v1.1H9.6z"></path>
</svg>

<style>
  .insignia {
    flex: none;
  }

  .insignia__field {
    fill: var(--red);
    transition: fill var(--dur-2) var(--ease-out);
  }

  .insignia__frame {
    fill: none;
    stroke: var(--bone);
    stroke-width: 0.6;
    opacity: 0.45;
  }

  .insignia__wall,
  .insignia__blade {
    fill: var(--bone);
  }

  .insignia__blade {
    transform-origin: 12px 16px;
    transition: transform var(--dur-2) var(--ease-out);
  }
</style>
