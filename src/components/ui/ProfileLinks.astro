---
/**
 * GitHub, LinkedIn, résumé, email: whichever are set in profile.ts.
 * `variant="inline"` is a quiet row of labels; `variant="rows"` is the
 * contact-sheet layout with handles and rules.
 */
import Arrow from './Arrow.astro';
import { profileLinks } from '../../lib/links';

interface Props {
  variant?: 'inline' | 'rows';
  /** Leave some out where they'd repeat nearby content (e.g. email beside the big email link). */
  exclude?: string[];
  class?: string;
}

const { variant = 'inline', exclude = [], class: className } = Astro.props;
const links = profileLinks().filter((l) => !exclude.includes(l.id));
---

{
  links.length > 0 && (
    <ul class:list={['plinks', `plinks--${variant}`, className]}>
      {links.map((link) => (
        <li>
          <a
            class="plinks__link"
            href={link.href}
            target={link.newTab ? '_blank' : undefined}
            rel={link.newTab ? (link.me ? 'me noopener' : 'noopener') : undefined}
          >
            <span class="plinks__label">{link.label}</span>
            {variant === 'rows' && link.detail && <span class="plinks__detail">{link.detail}</span>}
            <Arrow dir={link.newTab ? 'out' : 'right'} />
            {link.newTab && <span class="vh">(opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .plinks--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .plinks--inline .plinks__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-family: var(--type-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(50% + 0.9em) / 0 1px;
    transition: background-size var(--dur-2) var(--ease-out);
  }

  .plinks--inline .arrow {
    width: 0.7rem;
    height: 0.55rem;
  }

  .plinks--rows li {
    border-top: 1px solid var(--color-rule);
  }

  .plinks--rows li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .plinks--rows .plinks__link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: 2.75rem;
  }

  .plinks--rows .plinks__label {
    font-family: var(--type-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .plinks--rows .plinks__detail {
    font-family: var(--type-display);
    font-size: var(--text-m);
    font-stretch: 85%;
    overflow-wrap: anywhere;
  }

  .plinks--rows .arrow {
    width: 0.9rem;
    height: 0.7rem;
    align-self: center;
  }

  @media (hover: hover) {
    .plinks--inline .plinks__link:hover {
      background-size: 100% 1px;
    }

    .plinks__link:hover .arrow {
      transform: translate(0.15rem, -0.1rem);
    }

    .plinks--rows .plinks__link:hover .plinks__detail {
      color: var(--color-accent-text);
    }
  }
</style>
