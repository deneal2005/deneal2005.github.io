---
/**
 * Chapter 04 — Precepts, laid out as a manga page. Each panel doesn't just
 * state its precept, it performs it: Ma is nearly empty, Kata is a grid,
 * Shu-Ha-Ri breaks a line in three steps, Zanshin is the moment after.
 * Each also names where the idea shows up in real work (src/data/precepts.ts).
 */
import ChapterOpener from '../ui/ChapterOpener.astro';
import PreceptText from '../ui/PreceptText.astro';
import { chapterById } from '../../data/chapters';
import { precepts } from '../../data/precepts';
import { brushStroke, rng, round } from '../../lib/draw';

const chapter = chapterById('precepts');
const { ma, kata, shuhari, zanshin } = precepts;

// Focus lines for the zanshin panel: tapered wedges converging on the cut sun.
const random = rng(42);
const focus = { x: 1180, y: 200 };
const speedLines = Array.from({ length: 110 }, () => {
  const a = random() * Math.PI * 2;
  const inner = 120 + random() * 160;
  const spread = 0.004 + random() * 0.01;
  const far = 1600;
  const p = (r: number, da: number) => `${round(focus.x + Math.cos(a + da) * r)},${round(focus.y + Math.sin(a + da) * r)}`;
  return `<polygon points="${p(inner, 0)} ${p(far, spread)} ${p(far, -spread)}"/>`;
}).join('');

const freeStroke = brushStroke({ from: [8, 62], to: [152, 30], width: 9, peak: 0.3, seed: 31, wobble: 0.6, segments: 30 });
const kataCells = Array.from({ length: 42 }, (_, i) => i);
---

<section
  id={chapter.id}
  class="precepts wrap"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="precepts-title"
>
  <ChapterOpener id="precepts" epigraph="Four ideas I keep coming back to, each drawn the way it asks to be read, and each with a place it shows up in my work." />

  <div class="page">
    <!-- 間 Ma: the panel is the pause -->
    <article class="cell cell--ma" data-reveal="panel" style="--i: 0">
      <div class="panel">
        <div class="panel__inner">
          <span class="ma__stop" aria-hidden="true"></span>
          <PreceptText precept={ma} class="precept--corner" />
        </div>
      </div>
    </article>

    <!-- 型 Kata: form, repeated until it disappears -->
    <article class="cell cell--kata" data-reveal="panel" style="--i: 1">
      <div class="panel">
        <div class="panel__inner">
          <div class="kata__grid" aria-hidden="true">
            {kataCells.map((i) => <span class:list={['kata__cell', { 'is-odd': i === 23 }]} />)}
          </div>
          <PreceptText precept={kata} />
        </div>
      </div>
    </article>

    <!-- 守破離 Shu-Ha-Ri: the same line, followed, broken, left behind -->
    <article class="cell cell--shuhari" data-reveal="panel" style="--i: 2">
      <div class="panel">
        <div class="panel__inner">
          <PreceptText precept={shuhari} />
          <ol class="stages">
            {
              shuhari.stages.map((stage, i) => (
                <li class="stage">
                  <svg class="stage__line" viewBox="0 0 160 90" aria-hidden="true">
                    {i === 0 && (
                      <g>
                        <path d="M8 45H152" class="stage__ink" />
                        <path d="M8 38v14M44 41v8M80 38v14M116 41v8M152 38v14" class="stage__tick" />
                      </g>
                    )}
                    {i === 1 && (
                      <g>
                        <path d="M8 45H70" class="stage__ink" />
                        <path d="M88 33L152 33" class="stage__ink" />
                        <path d="M74 52L84 26" class="stage__break" />
                      </g>
                    )}
                    {i === 2 && <path d={freeStroke} class="stage__brush" />}
                  </svg>
                  <p class="stage__ja" lang="ja" aria-hidden="true">
                    {stage.ja}
                  </p>
                  <p class="stage__gloss meta">
                    {stage.name} · {stage.gloss}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </article>

    <!-- 残心 Zanshin: the moment after the cut -->
    <article class="cell cell--zanshin" data-reveal="panel" style="--i: 3">
      <div class="panel" data-tone="ink">
        <div class="panel__inner">
          <svg class="zanshin__lines" viewBox="0 0 1400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g set:html={speedLines} />
            <circle cx={focus.x} cy={focus.y} r="104" class="zanshin__clear"></circle>
            <g transform={`translate(${focus.x - 46} ${focus.y - 46}) scale(3.85)`}>
              <path class="zanshin__sun" d="M3.6 6.9 A10 10 0 0 1 19.7 18.1 Z" transform="translate(1.4 -2)"></path>
              <path class="zanshin__sun" d="M3.6 6.9 A10 10 0 0 0 19.7 18.1 Z" transform="translate(-1.4 2)"></path>
            </g>
          </svg>
          <span class="zanshin__scrim" aria-hidden="true"></span>
          <PreceptText precept={zanshin} class="precept--wide" />
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .precepts {
    padding-block: var(--space-section);
    --b: var(--panel-border);
    --slant: clamp(1.5rem, 4vw, 3.5rem);
  }

  /* ── The page ──────────────────────────────────────── */
  .page {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(24rem, auto) minmax(22rem, auto) minmax(18rem, auto);
    gap: 0.9rem;
  }

  .cell {
    display: grid;
  }

  .cell--ma {
    grid-column: 1 / 9;
    grid-row: 1;
  }

  .cell--kata {
    grid-column: 9 / -1;
    grid-row: 1 / 3;
  }

  .cell--shuhari {
    grid-column: 1 / 9;
    grid-row: 2;
  }

  .cell--zanshin {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  /* A panel is an ink shape with a paper shape inset inside it: a drawn border
     that survives slanted edges, which plain CSS borders can't. */
  .panel {
    display: grid;
    padding: var(--b);
    background: var(--sumi);
    clip-path: var(--shape);
  }

  .panel__inner {
    position: relative;
    display: grid;
    background: var(--color-bg);
    clip-path: var(--shape);
    overflow: hidden;
  }

  .cell--ma .panel,
  .cell--ma .panel__inner {
    --shape: polygon(0 0, 100% 0, 100% calc(100% - var(--slant)), 0 100%);
  }

  .cell--shuhari .panel,
  .cell--shuhari .panel__inner {
    --shape: polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
  }

  /* 間: almost nothing, on purpose */
  .panel__inner :global(.precept--corner) {
    justify-self: end;
    max-width: 22rem;
    padding-bottom: calc(var(--slant) + 1.5rem);
  }

  .ma__stop {
    position: absolute;
    top: 38%;
    left: 22%;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--shu);
  }

  /* 型: the grid */
  .cell--kata .panel__inner {
    grid-template-rows: 1fr auto;
  }

  .kata__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.55rem;
    align-content: start;
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .kata__cell {
    aspect-ratio: 1;
    border: 1.5px solid var(--color-rule-strong);
  }

  .kata__cell.is-odd {
    background: var(--shu);
    border-color: var(--shu);
    transform: rotate(9deg);
  }

  /* 守破離 */
  .cell--shuhari .panel__inner {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
  }

  .stages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    padding: calc(var(--slant) + 1.5rem) clamp(1.25rem, 2.5vw, 2.25rem) clamp(1.25rem, 2.5vw, 2.25rem) 0;
  }

  .stage {
    display: grid;
    gap: var(--space-2);
  }

  .stage__line {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1.5px solid var(--color-rule-strong);
    margin-bottom: var(--space-2);
  }

  .stage__ink {
    fill: none;
    stroke: var(--sumi);
    stroke-width: 3;
  }

  .stage__tick {
    fill: none;
    stroke: var(--sumi);
    stroke-width: 1;
  }

  .stage__break {
    fill: none;
    stroke: var(--shu);
    stroke-width: 2.5;
  }

  .stage__brush {
    fill: var(--sumi);
  }

  .stage__ja {
    font-family: var(--type-jp);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
  }

  /* 残心 */
  .cell--zanshin .panel__inner {
    align-items: center;
  }

  .zanshin__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--washi);
    opacity: 0.9;
  }

  .zanshin__lines g:first-child {
    opacity: 0.35;
  }

  .zanshin__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--sumi) 0%, rgb(5 6 6 / 0.92) 34%, rgb(5 6 6 / 0) 62%);
  }

  .zanshin__clear {
    fill: var(--sumi);
  }

  .zanshin__sun {
    fill: var(--shu);
  }

  .panel__inner :global(.precept--wide) {
    max-width: 34rem;
    align-self: center;
  }

  /* ── Small screens: panels stack, gutters keep their slant ── */
  @media (max-width: 63.99rem) {
    /* Stacked, the text fills the panel; the single mark moves to the empty corner */
    .ma__stop {
      top: calc(var(--space-6) + 0.5rem);
      left: auto;
      right: var(--space-6);
    }

    .page {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .cell--ma,
    .cell--kata,
    .cell--shuhari,
    .cell--zanshin {
      grid-column: 1;
      grid-row: auto;
    }

    .cell--ma .panel__inner {
      min-height: 24rem;
    }

    .cell--kata .panel,
    .cell--kata .panel__inner {
      --shape: polygon(0 var(--slant), 100% 0, 100% calc(100% - var(--slant)), 0 100%);
    }

    .cell--kata .panel__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .kata__grid {
      padding-top: calc(var(--slant) + 1.25rem);
      grid-template-columns: repeat(7, 1fr);
    }

    .panel__inner :global(.precept--corner),
    .cell--kata :global(.precept) {
      padding-bottom: calc(var(--slant) + 1.25rem);
    }

    .cell--shuhari .panel__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell--shuhari :global(.precept) {
      padding-top: calc(var(--slant) + 1.25rem);
    }

    .stages {
      padding: 0 clamp(1.25rem, 2.5vw, 2.25rem) clamp(1.25rem, 2.5vw, 2.25rem);
    }

    .cell--zanshin .panel__inner {
      min-height: 30rem;
      align-items: end;
    }

    .zanshin__lines {
      height: 60%;
    }

    .zanshin__scrim {
      background: linear-gradient(0deg, var(--sumi) 0%, rgb(5 6 6 / 0.92) 40%, rgb(5 6 6 / 0) 62%);
    }
  }
</style>
