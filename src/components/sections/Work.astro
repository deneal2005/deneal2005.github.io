---
import ChapterOpener from '../ui/ChapterOpener.astro';
import ProjectSpread from '../work/ProjectSpread.astro';
import { chapterById } from '../../data/chapters';
import { getWorks } from '../../lib/content';

const chapter = chapterById('work');
const works = await getWorks();
---

<section
  id={chapter.id}
  class="work wrap"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="work-title"
>
  <ChapterOpener
    id="work"
    epigraph="Two projects, built end to end and live. Each has its own case study."
  />
  <ol class="work__list">
    {
      works.map((work) => (
        <li class="work__item">
          <ProjectSpread work={work} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .work {
    padding-block: var(--space-section);
  }

  .work__list {
    display: grid;
    row-gap: var(--space-section);
  }
</style>
