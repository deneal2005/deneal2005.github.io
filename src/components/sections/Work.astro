---
import { getCollection } from 'astro:content';
import ChapterOpener from '../ui/ChapterOpener.astro';
import ProjectSpread from '../work/ProjectSpread.astro';
import { chapterById } from '../../data/chapters';

const chapter = chapterById('work');
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section
  id={chapter.id}
  class="work wrap"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="work-title"
>
  <ChapterOpener
    id="work"
    epigraph="Five commissions, one to a chapter. Each began with a brief and turned on a single decision."
  />
  <ol class="work__list">
    {
      works.map((work) => (
        <li class="work__item">
          <ProjectSpread work={work} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .work {
    padding-block: var(--space-section);
  }

  .work__list {
    display: grid;
    row-gap: var(--space-section);
  }
</style>
