---
/** Chapter 01 — The Hand: who this is, what they make, where to find them. Facts only. */
import ChapterOpener from '../ui/ChapterOpener.astro';
import Plate from '../ui/Plate.astro';
import Arrow from '../ui/Arrow.astro';
import ProfileLinks from '../ui/ProfileLinks.astro';
import Education from '../ui/Education.astro';
import { chapterById } from '../../data/chapters';
import { site } from '../../data/site';
import { plates, plateSize, plateUrl } from '../../lib/plates';
import { getGitHub } from '../../lib/github';
import { getExperiments, getJourney, getWorks } from '../../lib/content';

const chapter = chapterById('hand');
const portrait = plateSize(plates.sunrise, 'a');
const github = await getGitHub();
const [works, experiments, journey] = await Promise.all([getWorks(), getExperiments(), getJourney()]);
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const { about } = site;

const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const facts = [
  github.status === 'ok' && { label: 'On GitHub since', value: monthYear.format(new Date(github.memberSince)) },
  { label: 'Working toward', value: 'Software backend engineering' },
  {
    label: 'In this volume',
    value: [
      count(works.length, 'project', 'projects'),
      count(experiments.length, 'experiment', 'experiments'),
      count(journey.length, 'journal entry', 'journal entries'),
    ].join(' · '),
  },
].filter((f): f is { label: string; value: string } => Boolean(f));
---

<section
  id={chapter.id}
  class="hand wrap"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="hand-title"
>
  <ChapterOpener id="hand" epigraph="Who I am, what I make, and where to find me." />

  <div class="hand__profile grid">
    <figure class="hand__portrait">
      {
        site.portrait ? (
          <img class="hand__photo" src={site.portrait.src} alt={site.portrait.alt} loading="lazy" decoding="async" />
        ) : (
          <Plate
            src={plateUrl('sunrise')}
            alt="A vermilion sun rising through haze, printed entirely in halftone dots above an ink horizon."
            width={portrait.width}
            height={portrait.height}
          />
        )
      }
      <figcaption class="meta">{site.portrait ? site.name : 'Self-portrait, as a sunrise.'}</figcaption>
    </figure>

    <div class="hand__intro">
      <p class="hand__lede lede" data-reveal="fade">{about.who}</p>
      <p class="hand__what" data-reveal="fade" style="--i: 2">{about.what}</p>

      <dl class="hand__facts" data-reveal="fade" style="--i: 3">
        {
          facts.map((fact) => (
            <div>
              <dt class="meta">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <Education />

      {
        (about.exploring.length > 0 || about.learning.length > 0) && (
          <div class="hand__lists">
            {about.exploring.length > 0 && (
              <div>
                <h3 class="meta">Exploring</h3>
                <ul>
                  {about.exploring.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
            {about.learning.length > 0 && (
              <div>
                <h3 class="meta">Learning</h3>
                <ul>
                  {about.learning.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }

      <p class="hand__think">
        <a class="hand__think-link" href="#precepts">
          <span class="meta">How I think</span>
          <span class="hand__think-text">Four precepts, each shown in real work, in Chapter 04</span>
          <Arrow />
        </a>
      </p>

      <ProfileLinks variant="rows" class="hand__links" />
    </div>
  </div>
</section>

<style>
  .hand {
    padding-block: var(--space-section);
  }

  .hand__profile {
    align-items: start;
    row-gap: var(--space-7);
  }

  .hand__portrait {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--masthead-h) + var(--space-5));
  }

  .hand__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  .hand__portrait figcaption {
    margin-top: var(--space-3);
  }

  .hand__intro {
    grid-column: 7 / -1;
  }

  .hand__lede {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.75rem);
    line-height: 1.04;
  }

  .hand__what {
    margin-top: var(--space-6);
    max-width: 34rem;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.65;
  }

  .hand__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--gutter);
    margin-top: var(--space-7);
    max-width: 34rem;
  }

  .hand__facts div {
    padding-top: var(--space-3);
    border-top: var(--panel-border) solid var(--sumi);
  }

  .hand__facts dd {
    margin: var(--space-2) 0 0;
    font-family: var(--type-display);
    font-size: var(--text-m);
    font-stretch: 85%;
    line-height: 1.2;
  }

  .hand__intro :global(.edu) {
    margin-top: var(--space-8);
  }

  .hand__lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: var(--space-7);
    max-width: 34rem;
  }

  .hand__lists ul {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }

  .hand__think {
    margin-top: var(--space-7);
    max-width: 34rem;
  }

  .hand__think-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-4);
    background: var(--washi-deep);
    transition: background-color var(--dur-1) linear;
  }

  .hand__think-text {
    font-family: var(--type-display);
    font-size: var(--text-m);
    font-style: italic;
    font-stretch: 85%;
    line-height: 1.2;
  }

  @media (hover: hover) {
    .hand__think-link:hover {
      background: var(--gofun);
    }

    .hand__think-link:hover .arrow {
      transform: translateX(0.25rem);
    }
  }

  .hand__intro :global(.hand__links) {
    margin-top: var(--space-7);
    max-width: 34rem;
  }

  @media (max-width: 63.99rem) {
    .hand__portrait,
    .hand__intro {
      grid-column: 1 / -1;
    }

    .hand__portrait {
      position: static;
      max-width: 24rem;
    }
  }

  @media (max-width: 30rem) {
    .hand__think-link {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hand__think-link .meta {
      grid-column: 1 / -1;
    }
  }
</style>
