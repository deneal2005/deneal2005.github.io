---
/**
 * Chapter 05 — Keiko (稽古), daily practice. Experiments, not products: they
 * come from src/content/experiments. Entries with a `demo` mount a live study
 * (scripts load only when the chapter approaches, see src/scripts/lab.ts);
 * the rest are listed as lab notes.
 */
import ChapterOpener from '../ui/ChapterOpener.astro';
import Arrow from '../ui/Arrow.astro';
import { chapterById } from '../../data/chapters';
import { formatDate, getExperiments } from '../../lib/content';

const chapter = chapterById('keiko');
const experiments = await getExperiments();
// Live studies keep a fixed reading order; everything else is a lab note, newest first.
const STUDY_ORDER = ['sumi', 'ten', 'hanko'];
const studies = experiments
  .filter((e) => e.data.demo)
  .sort((a, b) => STUDY_ORDER.indexOf(a.data.demo ?? '') - STUDY_ORDER.indexOf(b.data.demo ?? ''));
const notes = experiments.filter((e) => !e.data.demo);
---

<section
  id={chapter.id}
  class="keiko"
  data-tone="ink"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="keiko-title"
>
  <div class="wrap">
    <ChapterOpener
      id="keiko"
      epigraph="Keiko is the practice you do every day so the work on the day looks easy. Experiments, not products: these run in your browser."
    />

    <div class="lab">
      {
        studies.map((study, i) => (
          <article
            class:list={['study', { 'study--offset': i === 1 }]}
            id={`study-${study.id}`}
            data-lab={study.data.demo}
            aria-labelledby={`study-${study.id}-title`}
          >
            <header class="study__head">
              {study.data.ja && (
                <p class="study__ja" lang="ja" aria-hidden="true">
                  {study.data.ja}
                </p>
              )}
              <div>
                <h3 class="study__title" id={`study-${study.id}-title`}>
                  {study.data.title}
                </h3>
                <p class="meta">{study.data.stack.slice(0, 2).join(' · ')}</p>
              </div>
            </header>

            {study.data.demo === 'sumi' && (
              <>
                <div class="study__stage study__stage--paper">
                  <canvas
                    class="study__canvas study__canvas--draw"
                    role="img"
                    aria-label="A sheet of paper you can draw ink strokes on with a mouse, pen or finger."
                  />
                  <p class="study__hint meta" aria-hidden="true" data-sumi-hint>
                    Draw here
                  </p>
                </div>
                <p class="study__desc">{study.data.summary}</p>
                <button class="btn" type="button" data-sumi-clear>
                  Wash the sheet
                </button>
              </>
            )}

            {study.data.demo === 'ten' && (
              <>
                <div class="study__stage">
                  <canvas
                    class="study__canvas"
                    role="img"
                    aria-label="A vermilion sun drawn as a live halftone screen. The dots swell toward your pointer."
                  />
                </div>
                <p class="study__desc">{study.data.summary}</p>
                <button class="btn" type="button" data-ten-toggle aria-pressed="false">
                  Pause
                </button>
              </>
            )}

            {study.data.demo === 'hanko' && (
              <>
                <div class="study__stage study__stage--paper">
                  <canvas class="study__canvas" role="img" aria-label="A vermilion seal carved with your initials." data-hanko-canvas />
                </div>
                <p class="study__desc">{study.data.summary}</p>
                <form class="hanko__form" data-hanko-form>
                  <label class="meta" for="hanko-initials">
                    Your initials, up to four
                  </label>
                  <div class="hanko__row">
                    <input
                      id="hanko-initials"
                      class="hanko__input"
                      name="initials"
                      type="text"
                      maxlength="4"
                      autocomplete="off"
                      spellcheck="false"
                      value="DT"
                    />
                    <button class="btn" type="submit" data-hanko-download>
                      Download PNG
                    </button>
                  </div>
                </form>
              </>
            )}
          </article>
        ))
      }
    </div>

    {
      notes.length > 0 && (
        <div class="notes">
          <h3 class="notes__heading meta">Lab notes</h3>
          <ol class="notes__list">
            {notes.map((note) => (
              <li class="note" id={`study-${note.id}`}>
                <time class="meta" datetime={note.data.date.toISOString().slice(0, 10)}>
                  {formatDate(note.data.date)}
                </time>
                <div>
                  <p class="note__title">
                    {note.data.ja && (
                      <span lang="ja" aria-hidden="true">
                        {note.data.ja}{' '}
                      </span>
                    )}
                    {note.data.title}
                  </p>
                  <p class="note__summary">{note.data.summary}</p>
                </div>
                <p class="meta">{note.data.status}</p>
                <div class="note__links">
                  {note.data.links.live && (
                    <a class="link" href={note.data.links.live} target="_blank" rel="noopener">
                      Try it <Arrow dir="out" />
                    </a>
                  )}
                  {note.data.links.repo && (
                    <a class="link" href={note.data.links.repo} target="_blank" rel="noopener">
                      Source <Arrow dir="out" />
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .keiko {
    padding-block: var(--space-section);
  }

  .lab {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }

  .study--offset {
    margin-top: var(--space-9);
  }

  .study {
    display: grid;
    /* one column that can shrink below the seal form's natural width */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    justify-items: start;
  }

  .study__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    width: 100%;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .study__ja {
    font-family: var(--type-jp);
    font-weight: 800;
    font-size: 2.75rem;
    line-height: 0.9;
    color: var(--shu);
  }

  .study__title {
    font-family: var(--type-display);
    font-size: 2rem;
    font-style: italic;
    font-weight: 350;
    font-stretch: 80%;
    line-height: 1;
  }

  .study__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border: var(--panel-border) solid var(--washi);
    background: var(--sumi);
    overflow: hidden;
  }

  .study__stage--paper {
    background: #f2ece0;
  }

  .study__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .study__canvas--draw {
    touch-action: none;
    cursor: crosshair;
  }

  .study__hint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--nibi);
    pointer-events: none;
    transition: opacity var(--dur-2) linear;
  }

  .study__hint.is-hidden {
    opacity: 0;
  }

  .study__desc {
    max-width: 24rem;
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .hanko__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    width: 100%;
  }

  .hanko__row {
    display: flex;
    gap: var(--space-3);
  }

  .hanko__input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    background: transparent;
    border: 1.5px solid var(--color-rule-strong);
    border-radius: 0;
    font-family: var(--type-mono);
    font-size: 1rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .hanko__input:focus-visible {
    outline-offset: 2px;
  }

  .notes {
    margin-top: var(--space-9);
  }

  .notes__heading {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-text);
  }

  .note {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 7rem auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
  }

  .note__title {
    font-family: var(--type-display);
    font-size: var(--text-m);
    font-stretch: 85%;
  }

  .note__summary {
    margin-top: var(--space-1);
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .note__links {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-s);
  }

  @media (max-width: 47.99rem) {
    .note {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }

  @media (max-width: 63.99rem) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-9);
    }

    .study--offset {
      margin-top: 0;
    }

    .study__stage {
      aspect-ratio: 1;
    }
  }
</style>
