---
/**
 * 01 — The Wall. The opening: a tall section (about 520vh) whose sticky stage
 * plays one scroll-driven sequence, forward and backward:
 *
 *   the wall alone → tremors, dust and cracks → steam behind the parapet →
 *   a head rises, a hand grips the edge → the wall breaks open at its chest →
 *   the camera pulls back to show how large it is.
 *
 * Every layer is its own composited element, moved with transforms only, from
 * a handful of custom properties that scripts/wall.ts sets each frame. The art
 * is original and drawn in code (geometry in lib/titan.ts).
 *
 * When local footage exists in public/media (git-ignored), it plays as the
 * opening shot and hands over to the wall on the first scroll.
 *
 * Without JavaScript, or with reduced motion, the section is one screen: the
 * finished scene, still, under the opening text.
 */
import Arrow from '../ui/Arrow.astro';
import ProfileLinks from '../ui/ProfileLinks.astro';
import { sectionById } from '../../data/sections';
import { site } from '../../data/site';
import { getWorks } from '../../lib/content';
import { rng, round } from '../../lib/draw';
import { reelMedia } from '../../lib/media';
import { chips, cracks, fingers, handBack, holePath, PARAPET, posts, shards, wallFace } from '../../lib/titan';

const section = sectionById('wall');
const works = await getWorks();
const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');

// Dust shaken loose from the parapet. Fewer on small screens (see CSS).
const random = rng(77);
const dust = Array.from({ length: 22 }, (_, i) => ({
  x: round(4 + random() * 92, 1),
  s: round(1.5 + random() * 2.5, 1),
  dur: round(2.4 + random() * 2.6, 2),
  delay: round(-random() * 5, 2),
  far: i % 3 === 0,
}));

// Teeth along the grin: uneven, too many, set along the curve of the lip.
const teeth = Array.from({ length: 13 }, (_, i) => {
  const x = 712 + i * 13.5;
  const t = (x - 800) / 100;
  const y = 361 + 20 * (1 - t * t);
  const h = 9 + ((i * 7) % 5);
  return `<rect x="${round(x)}" y="${round(y - 2)}" width="10" height="${h}" rx="2.5"/>`;
}).join('');

// Each shard and chip is its own tiny SVG: moving one never repaints the others.
const W = 1600;
const H = 900;
const piece = (b: { x: number; y: number; w: number; h: number }, dx: number, dy: number) =>
  `left:${round((b.x / W) * 100, 3)}%;top:${round((b.y / H) * 100, 3)}%;width:${round((b.w / W) * 100, 3)}%;height:${round((b.h / H) * 100, 3)}%;` +
  `--tx:${round((dx / b.w) * 100, 1)}%;--ty:${round((dy / b.h) * 100, 1)}%`;

// The fingers, drawn once and used by both stages of the grip.
const fingerArt = fingers
  .map(
    (f) =>
      `<g><path d="${f.d}" fill="url(#h-skin)" stroke="#0b0807" stroke-width="2"/>` +
      `<path d="${f.knuckle}" fill="none" stroke="#c9a582" stroke-opacity="0.45" stroke-width="2.5" stroke-linecap="round"/>` +
      `<path d="${f.nail}" fill="#7b6655" opacity="0.7"/>` +
      f.creases.map((c) => `<path d="${c}" fill="none" stroke="#0b0807" stroke-width="2" stroke-opacity="0.7" stroke-linecap="round"/>`).join('') +
      `</g>`,
  )
  .join('');

// Stone courses on the wall: staggered block joints.
const courses = Array.from({ length: 12 }, (_, row) => {
  const y = PARAPET + 22 + row * 44;
  const offset = row % 2 ? 0 : 70;
  const joints = Array.from({ length: 13 }, (_, i) => `M${-100 + offset + i * 140} ${y}v44`).join('');
  return `M-120 ${y}H1720${joints}`;
}).join('');
---

<section
  id={section.id}
  class="wall"
  data-wall
  data-sector
  data-sector-no={section.no}
  data-sector-ja={section.ja}
  aria-labelledby="wall-title"
>
  <div class="wall__stage" data-wall-stage>
    <!-- ── The world: one 16:9 frame scaled to cover, so every layer lines up ── -->
    <div class="wall__camera" aria-hidden="true">
      <div class="wall__world">
        <div class="layer sky"></div>
        <div class="layer glow"></div>
        <div class="layer clouds"></div>

        <!-- The titan: it has been standing here the whole time -->
        <div class="layer titan">
        <svg class="titan__art" viewBox="0 0 1600 900" preserveAspectRatio="none">
          <defs>
            <radialGradient id="t-skin" cx="0.62" cy="0.18" r="0.9">
              <stop offset="0" stop-color="#4b3a30"></stop>
              <stop offset="0.45" stop-color="#2a201b"></stop>
              <stop offset="1" stop-color="#110d0b"></stop>
            </radialGradient>
            <linearGradient id="t-body" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2b211c"></stop>
              <stop offset="0.5" stop-color="#1a1310"></stop>
              <stop offset="1" stop-color="#3a1712"></stop>
            </linearGradient>
            <linearGradient id="t-rim" x1="0" y1="0" x2="1" y2="0.4">
              <stop offset="0" stop-color="#d9b48a" stop-opacity="0"></stop>
              <stop offset="0.55" stop-color="#d9b48a" stop-opacity="0.15"></stop>
              <stop offset="1" stop-color="#f0c896" stop-opacity="0.7"></stop>
            </linearGradient>
          </defs>

          <!-- body: shoulders running out of frame; seen only through the breach -->
          <path
            fill="url(#t-body)"
            d="M716 372C714 446 690 500 600 540L180 640V1300H1420V640L1000 540C910 500 886 446 884 372Z"
          ></path>
          <g class="titan__muscle" fill="none" stroke="#7a3a2c" stroke-opacity="0.32" stroke-width="2.2">
            <path d="M742 420C736 470 712 506 650 540"></path><path d="M762 430C760 488 748 520 700 552"></path>
            <path d="M858 420C864 470 888 506 950 540"></path><path d="M838 430C840 488 852 520 900 552"></path>
            <path d="M600 560C680 548 740 560 790 600"></path><path d="M1000 560C920 548 860 560 810 600"></path>
            <path d="M610 590C690 586 744 604 792 646"></path><path d="M990 590C910 586 856 604 808 646"></path>
            <path d="M640 630C700 630 750 650 794 690"></path><path d="M960 630C900 630 850 650 806 690"></path>
            <path d="M800 470V720"></path><path d="M560 600C600 680 640 760 700 820"></path><path d="M1040 600C1000 680 960 760 900 820"></path>
          </g>

          <!-- head -->
          <g class="titan__head">
            <path fill="#1f1714" d="M642 214C618 206 606 236 612 266C618 296 632 312 648 306Z"></path>
            <path fill="#2a1f1a" d="M958 214C982 206 994 236 988 266C982 296 968 312 952 306Z"></path>
            <path
              fill="url(#t-skin)"
              d="M800 56C902 56 960 130 962 228C964 300 946 350 914 392C882 432 842 450 800 450C758 450 718 432 686 392C654 350 636 300 638 228C640 130 698 56 800 56Z"
            ></path>
            <path
              fill="#0d0a09"
              d="M634 238C626 120 700 40 800 38C906 36 976 112 968 240L956 200L948 246L934 170L922 214L906 150L890 190L866 128L852 170L826 118L812 162L792 116L776 160L754 124L740 172L720 134L708 188L690 152L680 208L664 176L652 244Z"
            ></path>
            <path fill="none" stroke="#3a2d25" stroke-opacity="0.6" stroke-width="2" d="M700 80C690 110 692 140 704 170M760 54C748 90 750 120 760 150M840 52C852 86 852 116 844 150M900 76C912 106 912 136 902 166"></path>
            <!-- hollows, sockets, brow -->
            <path fill="#0d0908" opacity="0.55" d="M676 300C690 340 716 372 744 386C730 352 716 322 676 300Z"></path>
            <path fill="#0d0908" opacity="0.55" d="M924 300C910 340 884 372 856 386C870 352 884 322 924 300Z"></path>
            <ellipse fill="#070505" cx="744" cy="246" rx="40" ry="24"></ellipse>
            <ellipse fill="#070505" cx="856" cy="246" rx="40" ry="24"></ellipse>
            <path fill="none" stroke="#5e4a3d" stroke-width="3" stroke-opacity="0.6" d="M700 222C730 206 770 208 792 224M808 224C830 208 870 206 900 222"></path>
            <path fill="#0f0b09" opacity="0.7" d="M800 250C794 286 784 316 780 330C792 338 808 338 820 330C816 316 806 286 800 250Z"></path>
            <!-- the grin: too wide, and lipless -->
            <path fill="#080605" d="M698 354C738 392 862 392 902 354C876 392 836 404 800 404C764 404 724 392 698 354Z"></path>
            <g fill="#bdb09a" opacity="0.5"><Fragment set:html={teeth} /></g>
            <path fill="none" stroke="#5e4a3d" stroke-opacity="0.5" stroke-width="2" d="M698 354C738 384 862 384 902 354"></path>
            <!-- nostrils -->
            <path fill="#070505" d="M782 330c6-4 12-3 14 2c-6 2-10 2-14-2zM818 330c-6-4-12-3-14 2c6 2 10 2 14-2z"></path>
            <!-- rim light from the fire behind the wall -->
            <path fill="none" stroke="url(#t-rim)" stroke-width="4" d="M800 56C902 56 960 130 962 228C964 300 946 350 914 392"></path>
          </g>
        </svg>
          <span class="titan__eye" style="left:46.875%;top:27.78%"></span>
          <span class="titan__eye" style="left:53.125%;top:27.78%"></span>
        </div>

        <div class="layer steam"></div>

        <!-- The wall -->
        <svg class="layer stone" viewBox="0 0 1600 900" preserveAspectRatio="none">
          <defs>
            <linearGradient id="w-face" gradientUnits="userSpaceOnUse" x1="0" y1="434" x2="0" y2="1000">
              <stop offset="0" stop-color="#4a4640"></stop>
              <stop offset="0.12" stop-color="#34312c"></stop>
              <stop offset="0.6" stop-color="#211f1c"></stop>
              <stop offset="1" stop-color="#0e0d0c"></stop>
            </linearGradient>
            <linearGradient id="w-stain" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#000" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
            </linearGradient>
            <clipPath id="w-clip"><path clip-rule="evenodd" d={wallFace}></path></clipPath>
          </defs>
          <path fill="url(#w-face)" fill-rule="evenodd" d={wallFace}></path>
          <g fill="none" stroke="#090807" stroke-opacity="0.5" stroke-width="2" clip-path="url(#w-clip)"><path d={courses}></path></g>
          <!-- rain stains under the parapet -->
          <g fill="url(#w-stain)" clip-path="url(#w-clip)">
            <rect x="120" y="434" width="26" height="220"></rect><rect x="420" y="434" width="18" height="160"></rect>
            <rect x="1060" y="434" width="30" height="260"></rect><rect x="1340" y="434" width="20" height="180"></rect>
            <rect x="980" y="434" width="12" height="120"></rect>
          </g>
          <!-- parapet -->
          <rect x="-120" y={PARAPET} width="1840" height="22" fill="#55504a"></rect>
          <rect x="-120" y={PARAPET + 22} width="1840" height="10" fill="#0c0b0a" opacity="0.6"></rect>
          <rect class="stone__rim" x="-120" y={PARAPET - 1} width="1840" height="2" fill="#f0c896"></rect>
          <!-- cannons and lookouts: the human scale -->
          <g fill="#151311">
            {
              posts.map((post) => (
                <>
                  <rect x={post.x} y={PARAPET - 7} width="16" height="7" />
                  <rect x={post.x + 12} y={PARAPET - 6} width="14" height="2.5" />
                  {post.soldier && <path d={`M${post.x + 40} ${PARAPET}v-7h3v7zM${post.x + 40.2} ${PARAPET - 9.5}h2.6v2.4h-2.6z`} />}
                </>
              ))
            }
          </g>
        </svg>

        <!-- Cracks run ahead of the break -->
        <svg class="layer cracks" viewBox="0 0 1600 900" preserveAspectRatio="none">
          <g fill="none" stroke-linecap="round" stroke-linejoin="round">
            {cracks.map((c) => <path class="crack" d={c} pathLength="1" />)}
          </g>
          <path class="breach-line" d={holePath} pathLength="1"></path>
        </svg>

        <!-- Shards and chips, blown out of the breach toward the camera. One element each. -->
        <svg class="shard-defs" width="0" height="0" aria-hidden="true">
          <defs>
            <linearGradient id="s-face" gradientUnits="userSpaceOnUse" x1="0" y1="434" x2="0" y2="1000">
              <stop offset="0" stop-color="#4a4640"></stop>
              <stop offset="0.12" stop-color="#34312c"></stop>
              <stop offset="0.6" stop-color="#211f1c"></stop>
              <stop offset="1" stop-color="#0e0d0c"></stop>
            </linearGradient>
          </defs>
        </svg>
        {
          shards.map((sh, i) => (
            <svg
              class="shard"
              viewBox={`${sh.box.x} ${sh.box.y} ${sh.box.w} ${sh.box.h}`}
              preserveAspectRatio="none"
              style={`${piece(sh.box, sh.dx, sh.dy)};--r:${sh.r};--delay:${sh.delay}`}
            >
              <clipPath id={`s-${i}`}>
                <path d={sh.d} />
              </clipPath>
              <path d={sh.d} fill="url(#s-face)" stroke="url(#s-face)" stroke-width="2.5" stroke-linejoin="round" />
              <path d={courses} clip-path={`url(#s-${i})`} fill="none" stroke="#090807" stroke-opacity="0.5" stroke-width="2" />
            </svg>
          ))
        }
        {
          chips.map((c) => (
            <svg
              class="shard shard--chip"
              viewBox={`${c.box.x} ${c.box.y} ${c.box.w} ${c.box.h}`}
              preserveAspectRatio="none"
              style={`${piece(c.box, c.dx, c.dy)};--r:${c.r};--delay:${c.delay}`}
            >
              <path d={c.d} />
            </svg>
          ))
        }

        <!-- The grip. First the hand rises from behind the parapet (only what's above
             the edge can show), then the fingers hook down over the face. -->
        <div class="layer hand-edge">
          <svg class="layer hand hand--rise" viewBox="0 0 1600 900" preserveAspectRatio="none">
            <defs>
              <linearGradient id="h-skin" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#5a4537"></stop>
                <stop offset="0.25" stop-color="#3a2b23"></stop>
                <stop offset="1" stop-color="#1c1411"></stop>
              </linearGradient>
              <linearGradient id="h-back" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2a1f1a"></stop>
                <stop offset="1" stop-color="#3d2e25"></stop>
              </linearGradient>
            </defs>
            <path d={handBack} fill="url(#h-back)"></path>
            <Fragment set:html={fingerArt} />
          </svg>
        </div>
        <div class="layer hook-edge">
          <svg class="layer hand hand--hook" viewBox="0 0 1600 900" preserveAspectRatio="none">
            <Fragment set:html={fingerArt} />
          </svg>
        </div>

        <div class="layer dustcloud"></div>
        <div class="layer haze"></div>
      </div>
    </div>

    {
      reelMedia && (
        <video
          class="wall__film"
          data-wall-film
          data-src-hd={reelMedia.hd}
          data-src-sd={reelMedia.sd}
          poster={reelMedia.poster}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          disableRemotePlayback
          tabindex="-1"
          aria-hidden="true"
        />
      )
    }

    <div class="wall__dust" aria-hidden="true">
      {
        dust.map((p) => (
          <span class:list={['mote', { 'mote--far': p.far }]} style={`--x:${p.x}%;--s:${p.s}px;--dur:${p.dur}s;--delay:${p.delay}s`} />
        ))
      }
    </div>

    <div class="wall__shade" aria-hidden="true"></div>
    <div class="wall__scrim" aria-hidden="true"></div>
    <div class="wall__black" aria-hidden="true"></div>
    <div class="wall__flash" aria-hidden="true"></div>

    <!-- ── Interface ── -->
    <div class="wall__hud meta" aria-hidden="true">
      <span class="wall__hud-l">
        <span class="wall__tick"></span>
        <span lang="ja" class="jp">第{section.no}区画</span>
        <span class="wall__hud-en">Sector {section.no} · {section.title}</span>
      </span>
      <span class="wall__hud-r">
        <span lang="ja" class="jp">監視中</span> <span class="wall__hud-en">Surveillance</span>
        <span class="wall__readout" data-wall-readout>000</span>%
      </span>
    </div>

    <p class="wall__vertical" lang="ja" aria-hidden="true">第一防衛線</p>

    <div class="wall__open">
      <p class="wall__file meta">
        <span class="wall__file-no">{section.no}</span> Personnel record · <span lang="ja" class="jp">記録</span> · Status: active
      </p>
      <h1 id="wall-title" class="wall__title">
        <span class="wall__name">{first}</span>
        {last && <span class="wall__name wall__name--2">{last}</span>}
        <span class="vh">, {site.role}</span>
      </h1>
      <div class="wall__intro">
        <p class="wall__role">
          <span class="seal" lang="ja" aria-hidden="true">開発者</span>
          <span class="meta">{site.role}</span>
        </p>
        <p class="wall__lede">{site.statement}</p>
        <div class="wall__actions">
          <a class="btn btn--ink" href="#expeditions">View the expeditions <Arrow /></a>
          <a class="btn" href="/journey/">Campaign log</a>
        </div>
        <ProfileLinks class="wall__links" />
      </div>
    </div>

    <div class="wall__warning" aria-hidden="true">
      <p class="wall__warning-ja" lang="ja">警報</p>
      <div>
        <p class="wall__warning-en">Warning</p>
        <p class="meta"><span lang="ja" class="jp">巨人接近</span> · Titan approaching · Sector {section.no}</p>
      </div>
    </div>

    {
      works.length > 0 && (
        <div class="wall__next" aria-hidden="true">
          <p class="meta">
            <span lang="ja" class="jp">壁の外へ</span> · Beyond the wall
          </p>
          <p class="wall__next-title">The expeditions</p>
          <p class="meta wall__next-list">{works.map((w) => w.data.title).join(' · ')}</p>
        </div>
      )
    }

    <a class="wall__cue meta" href="#soldier">
      <span>Scroll</span><span lang="ja" class="jp" aria-hidden="true">前進</span>
      <span class="wall__cue-track" aria-hidden="true"><span></span></span>
    </a>
  </div>
</section>

<style>
  /*
   * Sequence state, set on the section by scripts/wall.ts. The defaults here
   * are the finished scene: what reduced-motion and no-JS visitors see.
   */
  .wall {
    --p: 1;
    --open: 1;
    --cam: 1;
    --shx: 0px;
    --shy: 0px;
    --rise: 1;
    --steam: 1;
    --glow: 1;
    --crack: 1;
    --frag: 1;
    --hand: 1;
    --eyes: 1;
    --flash: 0;
    --warn: 0;
    --fin: 0;
    --film: 0;
    --dust: 0;
    --end: 0;
    position: relative;
    height: 100svh;
    min-height: 36rem;
    background: var(--black);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wall {
      height: 520vh;
    }
  }

  .wall__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 36rem;
    overflow: clip;
    isolation: isolate;
  }

  /* ── Camera and world ─────────────────────────────── */
  .wall__camera {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--shx), var(--shy), 0) scale(calc(1.2 - var(--cam) * 0.2)) translateY(calc((1 - var(--cam)) * -5%));
    transform-origin: 50% 46%;
    will-change: transform;
  }

  .wall__world {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100%, 177.78svh);
    height: max(100%, 56.25vw);
    transform: translate(-50%, -50%);
  }

  /* Phones: frame the face and the grip, not the empty ends of the wall */
  @media (max-aspect-ratio: 3/4) {
    .wall__world {
      width: 230svh;
      height: 129.4svh;
      top: 44%;
    }
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    will-change: transform;
    pointer-events: none;
  }

  .sky {
    background:
      radial-gradient(60% 50% at 52% 52%, rgb(120 84 52 / 0.45), rgb(120 84 52 / 0) 70%),
      linear-gradient(180deg, #0b0b0b 0%, #1d1b18 28%, #3a3027 46%, #1b1714 60%, #0a0909 100%);
    transform: translateY(calc((1 - var(--cam)) * 2%));
  }

  /* The fire behind the wall: dirty amber, turning toward red as it breaks */
  .glow {
    background: radial-gradient(42% 34% at 50% 47%, rgb(226 120 60 / 0.55), rgb(179 35 28 / 0.25) 45%, rgb(179 35 28 / 0) 75%);
    opacity: calc(0.15 + var(--glow) * 0.85);
  }

  .clouds {
    background:
      radial-gradient(30% 9% at 22% 20%, rgb(80 72 64 / 0.55), transparent 70%),
      radial-gradient(36% 8% at 66% 14%, rgb(70 64 58 / 0.5), transparent 70%),
      radial-gradient(24% 7% at 88% 30%, rgb(84 74 64 / 0.45), transparent 70%),
      radial-gradient(28% 6% at 40% 36%, rgb(96 80 62 / 0.4), transparent 70%);
    transform: translate3d(calc(var(--p) * -4%), 0, 0);
  }

  /* Scaled past the frame, so once it has risen its skull is cut off by the top edge */
  .titan {
    transform: translate3d(0, calc((1 - var(--rise)) * 60%), 0) scale(1.14);
    transform-origin: 50% 100%;
  }

  .titan__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /* Eyes: small glowing elements of their own, so lighting them never repaints the head */
  .titan__eye {
    position: absolute;
    width: 2.4%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, #ffd2a8 0, #e2493d 30%, rgb(226 73 61 / 0) 100%);
    opacity: var(--eyes);
  }

  /* Steam off its skin, rising with it */
  .steam {
    background:
      radial-gradient(14% 18% at 40% 30%, rgb(206 196 180 / 0.32), transparent 70%),
      radial-gradient(12% 20% at 60% 24%, rgb(206 196 180 / 0.28), transparent 70%),
      radial-gradient(20% 14% at 50% 44%, rgb(206 196 180 / 0.3), transparent 70%),
      radial-gradient(10% 16% at 33% 42%, rgb(206 196 180 / 0.2), transparent 70%),
      radial-gradient(10% 18% at 68% 40%, rgb(206 196 180 / 0.22), transparent 70%);
    opacity: var(--steam);
    transform: translate3d(0, calc((1 - var(--steam)) * 18% - var(--p) * 6%), 0) scale(calc(0.9 + var(--steam) * 0.2));
  }

  .stone__rim {
    opacity: calc(var(--glow) * 0.55);
  }

  /* Cracks are the one painted change; scripts/wall.ts steps --crack in twentieths */
  .crack,
  .breach-line {
    fill: none;
    stroke: #050404;
