---
/**
 * Prologue: the opening reel. A tall section (about 420vh) whose sticky
 * stage plays the reel as a scroll-controlled image sequence: scroll
 * progress maps directly to playback position, forward and back
 * (scripts/reel.ts). The portfolio's opening, the owner's statement and a
 * closing credit are timed against it.
 *
 * Without JavaScript, or with reduced motion, the section is one screen tall:
 * the poster (or the original wall scene) and the opening text, nothing hidden.
 */
import WallScene from '../motifs/WallScene.astro';
import Arrow from '../ui/Arrow.astro';
import ProfileLinks from '../ui/ProfileLinks.astro';
import { chapterById } from '../../data/chapters';
import { site } from '../../data/site';
import { getWorks } from '../../lib/content';
import { reelMedia } from '../../lib/media';

const chapter = chapterById('prologue');
const works = await getWorks();

// The statement, cut into title cards: "…: the interface, the server behind it
// and the database rules underneath." If it no longer splits that way, the
// cards are simply left out; the full sentence is always in the opening.
const [, list = ''] = site.statement.split(': ');
const cards = list
  .replace(/\.$/, '')
  .split(/, | and (?=the )/)
  .map((s) => s.trim())
  .filter(Boolean);
const showCards = cards.length >= 2 && cards.length <= 4;

// Beat windows as fractions of the reel. Three cards sit over its calmer
// passages; any other count is spread evenly between the opening and the credit.
const windows =
  cards.length === 3
    ? [
        [0.1, 0.24],
        [0.38, 0.52],
        [0.62, 0.76],
      ]
    : cards.map((_, i) => {
        const span = 0.7 / cards.length;
        return [0.1 + i * span, 0.1 + (i + 1) * span - 0.03];
      });
const finale = [0.86, 1.01];
---

<section
  id={chapter.id}
  class:list={['reel', { 'reel--film': reelMedia }]}
  data-reel
  data-duration={reelMedia ? undefined : 60}
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="hero-title"
>
  <div class="reel__stage">
    <div class="reel__camera" aria-hidden="true">
      {
        reelMedia ? (
          <>
            {reelMedia.poster && <img class="reel__poster" src={reelMedia.poster} alt="" fetchpriority="high" decoding="async" />}
            <video
              class="reel__video"
              data-reel-video
              data-src-hd={reelMedia.hd}
              data-src-sd={reelMedia.sd}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableRemotePlayback
              tabindex="-1"
            />
          </>
        ) : (
          <WallScene />
        )
      }
    </div>

    <!-- Colour grade, vignette and the fades that melt the frame into the page -->
    <div class="reel__grade" aria-hidden="true"></div>
    <div class="reel__bars" aria-hidden="true"><span></span><span></span></div>

    <div class="reel__hud meta" aria-hidden="true">
      <span class="reel__hud-l"><span class="reel__dot"></span>Reel 01<span class="reel__hud-chapter"><span class="reel__sep"></span>{chapter.label}</span></span>
      <span class="reel__hud-r"><span data-reel-tc>00:00:00:00</span><span class="reel__status" data-reel-status></span></span>
    </div>

    <!-- The opening -->
    <div class="reel__open" data-beat data-in="-1" data-out="0.075">
      <h1 id="hero-title" class="reel__heading">
        <span class="reel__name title-wide">{site.name}</span>
        <span class="reel__title display">
          <span class="reel__line">Every line</span>
          <span class="reel__line reel__line--2"><em>is final</em><span class="reel__stop">.</span></span>
        </span>
      </h1>
      <div class="reel__intro">
        <p class="reel__role meta"><span class="reel__rule"></span>{site.role} · {site.volume}</p>
        <p class="reel__lede">{site.statement}</p>
        <div class="reel__actions">
          <a class="btn btn--ink" href="#work">See the work <Arrow /></a>
          <a class="btn" href="/journey/">Follow the journey</a>
        </div>
        <ProfileLinks class="reel__links" />
      </div>
    </div>

    <!-- Title cards: the statement, one clause per calm passage of the reel -->
    {
      showCards &&
        cards.map((card, i) => (
          <p
            class:list={['reel__card', `reel__card--${i + 1}`]}
            data-beat
            data-in={windows[i][0]}
            data-out={windows[i][1]}
            aria-hidden="true"
          >
            <span class="reel__card-n meta">
              {String(i + 1).padStart(2, '0')} <span class="reel__sep" /> {String(cards.length).padStart(2, '0')}
            </span>
            <span class="reel__card-text display">{card}</span>
          </p>
        ))
    }

    <!-- Closing credit -->
    <div class="reel__credit" data-beat data-in={finale[0]} data-out={finale[1]} aria-hidden="true">
      <p class="meta">A portfolio by</p>
      <p class="reel__credit-name title-wide">{site.name}</p>
      {
        works.length > 0 && (
          <p class="reel__credit-works meta">
            Featuring {works.map((w) => w.data.title).join(' · ')}
          </p>
        )
      }
    </div>

    <a class="reel__next meta" href="#hamon" data-reel-next>
      <span class="reel__next-label">Scroll</span>
      <span class="reel__track" aria-hidden="true"><span class="reel__fill"></span></span>
    </a>
  </div>
</section>

<style>
  /* ── Frame ────────────────────────────────────────────
   * --p is the reel's progress (0–1), set by scripts/reel.ts. Every beat gets
   * --o (opacity) and --t (travel through its own window, 0–1).
   */
  .reel {
    --p: 0;
    position: relative;
    height: 100svh;
    min-height: 34rem;
    background: var(--void);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .reel {
      height: 420vh;
    }
  }

  .reel__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    isolation: isolate;
  }

  /* The camera pushes in slowly as the reel runs */
  .reel__camera {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: var(--void);
    transform: scale(calc(1.08 - var(--p) * 0.08));
    transform-origin: 50% 45%;
  }

  .reel__poster,
  .reel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* The grade: muted, cooler, heavier blacks */
    filter: saturate(0.58) contrast(1.08) brightness(0.74) sepia(0.14);
  }

  .reel__video {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .reel[data-reel-ready] .reel__video {
    opacity: 1;
  }

  .reel__grade {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      /* the frame melts into the page below */
      linear-gradient(0deg, var(--void) 0%, rgb(8 9 10 / 0.7) 14%, rgb(8 9 10 / 0) 42%),
      /* and under the masthead */
      linear-gradient(180deg, rgb(8 9 10 / 0.75) 0%, rgb(8 9 10 / 0) 22%),
      /* a lower-left scrim for the type */
      radial-gradient(120% 90% at 0% 100%, rgb(8 9 10 / 0.78) 0%, rgb(8 9 10 / 0) 60%),
      /* vignette */
      radial-gradient(140% 110% at 50% 45%, rgb(8 9 10 / 0) 55%, rgb(8 9 10 / 0.7) 100%);
  }

  /* A tint that pulls every frame into the palette: steel shadows, bronze light */
  .reel__grade::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(77 88 67 / 0.22), rgb(138 106 64 / 0.16));
    mix-blend-mode: soft-light;
  }

  /* The end of the reel fades to black, and the page continues from the black */
  .reel__grade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--void);
    opacity: var(--end, 0);
  }

  /* Letterbox: arrives once the film starts, leaves before the credit */
  .reel__bars span {
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    height: calc(var(--bars, 0) * 7svh);
    background: var(--void);
  }

  .reel__bars span:first-child {
    top: 0;
  }

  .reel__bars span:last-child {
    bottom: 0;
  }

  /* ── HUD ──────────────────────────────────────────── */
  .reel__hud {
    position: absolute;
    top: calc(var(--masthead-h) + var(--space-2));
    left: var(--margin);
    right: var(--margin);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--ash);
    font-size: 0.625rem;
    pointer-events: none;
  }

  .reel__hud-l,
  .reel__hud-r {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reel__hud-r {
    font-variant-numeric: tabular-nums;
  }

  .reel__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .reel__dot {
      animation: rec 2.4s steps(1) infinite;
    }
  }

  @keyframes rec {
    50% {
      opacity: 0.2;
    }
  }

  .reel__hud-chapter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reel__sep {
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
    vertical-align: middle;
  }

  .reel__status:not(:empty) {
    color: var(--gold-light);
  }

  /* ── Beats ────────────────────────────────────────── */
  [data-beat] {
    --o: 1;
    --t: 0.5;
  }

  :global(.js) .reel [data-beat] {
    opacity: var(--o);
    visibility: var(--vis, visible);
  }

  /* ── The opening ──────────────────────────────────── */
  .reel__open {
    position: absolute;
    inset: auto var(--margin) clamp(4.5rem, 11svh, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 1fr);
    align-items: end;
    gap: var(--space-6) var(--gutter);
  }

  :global(.js) .reel__open {
    filter: blur(calc((1 - var(--o)) * 10px));
    transform: translateY(calc((1 - var(--o)) * -4vh));
  }

  .reel__heading {
    display: grid;
    gap: var(--space-4);
  }

  .reel__name {
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1.05rem);
    color: var(--bone);
  }

  :global(.js:not(.is-ready)) .reel__name,
  :global(.js:not(.is-ready)) .reel__line,
  :global(.js:not(.is-ready)) .reel__intro {
    opacity: 0;
  }

  .reel__title {
    display: block;
    font-size: clamp(3.4rem, min(10vw, 20svh), 12.5rem);
    font-weight: 300;
    line-height: 0.84;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .reel__line {
    display: block;
  }

  .reel__line--2 {
    padding-left: 0.55em;
  }

  .reel__title em {
    font-style: italic;
    font-weight: 250;
    text-transform: none;
  }

  .reel__stop {
    color: var(--gold);
    font-style: normal;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js.is-ready) .reel__name {
      animation: title-in 1.6s var(--ease-out) both;
    }

    :global(.js.is-ready) .reel__line {
      animation: title-in 1.8s var(--ease-out) both;
      animation-delay: 250ms;
    }

    :global(.js.is-ready) .reel__line--2 {
      animation-delay: 450ms;
    }

    :global(.js.is-ready) .reel__intro {
      animation: title-in 1.6s var(--ease-out) 800ms both;
    }
  }

  /* Type surfaces out of the dark: tracking settles, focus pulls in */
  @keyframes title-in {
    from {
      opacity: 0;
      filter: blur(12px);
      letter-spacing: 0.08em;
      transform: translateY(1.5rem);
    }
  }

  .reel__intro {
    max-width: 26rem;
    justify-self: end;
    font-size: var(--text-s);
    line-height: 1.6;
    color: var(--bone);
  }

  .reel__role {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--gold-light);
  }

  .reel__rule {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }

  .reel__lede {
    margin-top: var(--space-4);
    color: rgb(232 225 210 / 0.86);
    text-wrap: pretty;
  }

  .reel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .reel__intro :global(.reel__links) {
    margin-top: var(--space-3);
  }

  /* ── Title cards ──────────────────────────────────── */
  .reel__card {
    position: absolute;
    left: var(--margin);
    bottom: clamp(5rem, 16svh, 10rem);
    display: grid;
    gap: var(--space-4);
    max-width: min(60rem, 80vw);
    pointer-events: none;
    transform: translateY(calc((0.5 - var(--t)) * 7svh));
  }

  /* Alternate sides so the cards never sit on the same part of the frame twice */
  .reel__card--2 {
    left: auto;
    right: var(--margin);
    text-align: right;
    justify-items: end;
  }

  .reel__card-n {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--gold-light);
  }

  .reel__card-text {
    font-size: clamp(2.6rem, 1.4rem + 6vw, 8.5rem);
    font-weight: 300;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--bone);
    text-shadow: 0 0.04em 0.6em rgb(8 9 10 / 0.6);
    text-wrap: balance;
    letter-spacing: calc(0.02em + (1 - var(--o)) * 0.06em);
  }

  /* ── Closing credit ───────────────────────────────── */
  .reel__credit {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding-inline: var(--margin);
    text-align: center;
    pointer-events: none;
  }

  .reel__credit-name {
    font-size: clamp(1.4rem, 0.9rem + 2.6vw, 3.4rem);
    font-weight: 250;
    color: var(--bone);
    margin-right: calc(var(--tracking-title) * -1);
  }

  .reel__credit-works {
    color: var(--gold-light);
  }

  /* Without the reel there are no cards or credit to time: the opening is the hero. */
  :global(html:not(.js)) .reel__card,
  :global(html:not(.js)) .reel__credit {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__card,
    .reel__credit,
    .reel__bars {
      display: none;
    }
  }

  /* ── Scroll cue ───────────────────────────────────── */
  .reel__next {
    position: absolute;
    right: var(--margin);
    bottom: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--ash);
    opacity: calc(1 - var(--end, 0));
  }

  .reel__track {
    position: relative;
    width: clamp(4rem, 12vw, 9rem);
    height: 1px;
    background: var(--color-rule-strong);
    overflow: hidden;
  }

  .reel__fill {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleX(var(--p));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.js)) .reel__fill,
    .reel__next[data-idle] .reel__fill {
      animation: cue 2.6s var(--ease-in-out) infinite;
    }
  }

  @keyframes cue {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    50% {
      transform: scaleX(1);
      transform-origin: left;
    }
    50.1% {
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }

  /* ── Smaller screens ──────────────────────────────── */
  @media (max-width: 63.99rem) {
    .reel__open {
      grid-template-columns: minmax(0, 1fr);
      bottom: clamp(4.25rem, 9svh, 6rem);
    }

    .reel__intro {
      justify-self: start;
    }
  }

  @media (max-width: 47.99rem) {
    .reel__hud-chapter {
      display: none;
    }

    .reel__title {
      font-size: clamp(3rem, 16.5vw, 6rem);
    }

    .reel__line--2 {
      padding-left: 0.35em;
    }

    .reel__lede {
      font-size: 0.875rem;
    }

    .reel__card,
    .reel__card--2 {
      left: var(--margin);
      right: var(--margin);
      max-width: none;
      text-align: left;
      justify-items: start;
    }

    .reel__card-text {
      font-size: clamp(2.4rem, 13vw, 4.5rem);
    }

    .reel__next {
      bottom: var(--space-3);
    }

    .reel__next-label {
      display: none;
    }
  }

  /* Short landscape screens: drop the lede so the headline keeps the frame */
  @media (min-aspect-ratio: 5/4) and (max-height: 640px) {
    .reel__lede {
      display: none;
    }

    .reel__title {
      font-size: clamp(3rem, min(9vw, 17svh), 12.5rem);
    }
  }
</style>
