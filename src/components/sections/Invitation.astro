---
/**
 * Final chapter — The Invitation. The volume opened on a sun cut in two;
 * it closes on a whole one, rising. Contact leads with LinkedIn, email and
 * phone as icon tiles; everything else follows as rows.
 */
import ProfileLinks from '../ui/ProfileLinks.astro';
import { chapterById } from '../../data/chapters';
import { site } from '../../data/site';

const chapter = chapterById('invitation');
const contact = ['linkedin', 'email', 'phone'];
---

<section
  id={chapter.id}
  class="invite"
  data-tone="ink"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="invitation-title"
>
  <div class="invite__sky" aria-hidden="true">
    <div class="invite__sun" data-depth="0.22"></div>
  </div>

  <div class="invite__inner wrap">
    <div class="invite__head">
      <p class="meta invite__label">{chapter.label} · {chapter.title}</p>
      <p class="invite__ja tate" lang="ja" aria-hidden="true">{chapter.ja}</p>
    </div>

    <h2 id="invitation-title" class="invite__title display" data-reveal="rise">
      <span class="rise" style="--line: 0"><span>The next chapter</span></span>
      <span class="rise" style="--line: 1"><span><em>starts with a {site.email ? 'letter' : 'message'}.</em></span></span>
    </h2>

    <div class="invite__grid">
      <p class="invite__body" data-reveal="fade">
        A question about something in this volume, a thing you’d like to build together, or a bug you found in it: write
        to me.
      </p>

      <div class="invite__contact" data-reveal="fade" style="--i: 2">
        <ProfileLinks variant="tiles" only={contact} class="invite__tiles" />
        {
          site.email && (
            <div class="invite__actions">
              <button class="btn" type="button" data-copy={site.email}>
                <span data-copy-label>Copy email</span>
              </button>
            </div>
          )
        }
        <p class="vh" aria-live="polite" data-copy-status></p>
        <ProfileLinks variant="rows" exclude={contact} class="invite__links" />
      </div>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    min-height: 100svh;
    padding-block: var(--space-section) 0;
    overflow: clip;
    isolation: isolate;
  }

  .invite__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* The whole sun, rising as the chapter scrolls into place. */
  .invite__sun {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(120vw, 82rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--shu);
    box-shadow: 0.6rem 0.4rem 0 var(--enji);
    transform: translate(-50%, calc(62% + var(--depth, 0px)));
  }

  .invite__inner {
    position: relative;
    padding-bottom: clamp(18rem, 42vw, 36rem);
  }

  .invite__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: var(--space-4);
    border-top: var(--panel-border) solid var(--washi);
  }

  .invite__label {
    color: var(--color-text);
  }

  .invite__ja {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 5rem);
    color: var(--shu-light);
  }

  .invite__title {
    margin-top: var(--space-6);
    font-size: var(--text-giga);
    font-weight: 300;
    text-transform: uppercase;
  }

  .invite__title em {
    font-style: italic;
    text-transform: none;
    color: var(--shu-light);
  }

  .invite__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-7);
    margin-top: var(--space-8);
    align-items: start;
  }

  .invite__body {
    grid-column: 1 / span 4;
    color: var(--color-text-muted);
  }

  .invite__contact {
    grid-column: 6 / -1;
  }


  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }


  .invite__contact :global(.invite__links) {
    margin-top: var(--space-7);
    max-width: 36rem;
  }

  .invite__actions :global(.btn.is-copied) {
    background-color: var(--shu);
    border-color: var(--shu);
    color: var(--gofun);
  }

  @media (max-width: 63.99rem) {
    .invite__body,
    .invite__contact {
      grid-column: 1 / -1;
    }

    .invite__title {
      font-size: clamp(2.9rem, 13vw, 6rem);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .invite__sun {
      transform: translate(-50%, 62%);
    }
  }
</style>
