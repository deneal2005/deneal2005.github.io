---
/**
 * Final chapter — The Invitation. The volume opened on a sun cut in two;
 * it closes on a whole one, rising. Leads with email when one is set in
 * profile.ts, otherwise with GitHub.
 */
import Arrow from '../ui/Arrow.astro';
import ProfileLinks from '../ui/ProfileLinks.astro';
import { chapterById } from '../../data/chapters';
import { githubUrl } from '../../data/profile';
import { site } from '../../data/site';

const chapter = chapterById('invitation');
const primary = site.email
  ? { id: 'email', href: `mailto:${site.email}`, text: site.email, newTab: false }
  : githubUrl
    ? { id: 'github', href: githubUrl, text: `github.com/${site.links.github}`, newTab: true }
    : null;
---

<section
  id={chapter.id}
  class="invite"
  data-tone="ink"
  data-chapter-label={chapter.label}
  data-chapter-title={chapter.title}
  aria-labelledby="invitation-title"
>
  <div class="invite__sky" aria-hidden="true">
    <div class="invite__sun" data-depth="0.22"></div>
  </div>

  <div class="invite__inner wrap">
    <div class="invite__head">
      <p class="meta invite__label">{chapter.label} · {chapter.title}</p>
      <p class="invite__ja tate" lang="ja" aria-hidden="true">{chapter.ja}</p>
    </div>

    <h2 id="invitation-title" class="invite__title display" data-reveal="rise">
      <span class="rise" style="--line: 0"><span>The next chapter</span></span>
      <span class="rise" style="--line: 1"><span><em>starts with a {site.email ? 'letter' : 'message'}.</em></span></span>
    </h2>

    <div class="invite__grid">
      <p class="invite__body" data-reveal="fade">
        A question about something in this volume, a thing you’d like to build together, or a bug you found in it: write
        to me.
      </p>

      <div class="invite__contact" data-reveal="fade" style="--i: 2">
        {
          primary && (
            <a
              class="invite__email"
              href={primary.href}
              data-magnetic="0.18"
              target={primary.newTab ? '_blank' : undefined}
              rel={primary.newTab ? 'me noopener' : undefined}
            >
              <span>{primary.text}</span>
              <Arrow dir={primary.newTab ? 'out' : 'right'} />
              {primary.newTab && <span class="vh">(opens in a new tab)</span>}
            </a>
          )
        }
        <div class="invite__actions">
          {
            site.email && (
              <button class="btn" type="button" data-copy={site.email}>
                <span data-copy-label>Copy email</span>
              </button>
            )
          }
          <p class="meta invite__meta">
            Local time in {site.location.city}
            <time data-local-time={site.location.timeZone}>—</time>
          </p>
        </div>
        <p class="vh" aria-live="polite" data-copy-status></p>
        <ProfileLinks variant="rows" exclude={primary ? [primary.id] : []} class="invite__links" />
      </div>
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative;
    min-height: 100svh;
    padding-block: var(--space-section) 0;
    overflow: clip;
    isolation: isolate;
  }

  .invite__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* The whole sun, rising as the chapter scrolls into place. */
  .invite__sun {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(120vw, 82rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--shu);
    box-shadow: 0.6rem 0.4rem 0 var(--enji);
    transform: translate(-50%, calc(62% + var(--depth, 0px)));
  }

  .invite__inner {
    position: relative;
    padding-bottom: clamp(18rem, 42vw, 36rem);
  }

  .invite__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: var(--space-4);
    border-top: var(--panel-border) solid var(--washi);
  }

  .invite__label {
    color: var(--color-text);
  }

  .invite__ja {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 5rem);
    color: var(--shu-light);
  }

  .invite__title {
    margin-top: var(--space-6);
    font-size: var(--text-giga);
    font-weight: 300;
    text-transform: uppercase;
  }

  .invite__title em {
    font-style: italic;
    text-transform: none;
    color: var(--shu-light);
  }

  .invite__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-7);
    margin-top: var(--space-8);
    align-items: start;
  }

  .invite__body {
    grid-column: 1 / span 4;
    color: var(--color-text-muted);
  }

  .invite__contact {
    grid-column: 6 / -1;
  }

  .invite__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 100%;
    font-family: var(--type-display);
    font-size: clamp(1.9rem, 1rem + 3.4vw, 4.5rem);
    font-stretch: 75%;
    font-weight: 400;
    line-height: 1.05;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 100% 2px;
    padding-bottom: 0.1em;
    transition:
      transform 0.5s var(--ease-out),
      color var(--dur-1) linear;
  }

  .invite__email .arrow {
    width: 0.6em;
    height: 0.4em;
  }

  @media (hover: hover) {
    .invite__email:hover {
      color: var(--shu-light);
    }

    .invite__email:hover .arrow {
      transform: translateX(0.2em);
    }
  }

  .invite__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .invite__meta time {
    margin-left: var(--space-2);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .invite__contact :global(.invite__links) {
    margin-top: var(--space-7);
    max-width: 36rem;
  }

  .invite__actions :global(.btn.is-copied) {
    background-color: var(--shu);
    border-color: var(--shu);
    color: var(--gofun);
  }

  @media (max-width: 63.99rem) {
    .invite__body,
    .invite__contact {
      grid-column: 1 / -1;
    }

    .invite__title {
      font-size: clamp(2.9rem, 13vw, 6rem);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .invite__sun {
      transform: translate(-50%, 62%);
    }
  }
</style>
