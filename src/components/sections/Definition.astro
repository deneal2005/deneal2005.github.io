---
/** After the opening plate: what the word means, set like a dictionary entry. */
import HamonLine from '../motifs/HamonLine.astro';
---

<section id="hamon" class="definition wrap" aria-labelledby="definition-title">
  <div class="definition__grid grid">
    <p class="definition__kanji tate" lang="ja" aria-hidden="true">刃文</p>

    <div class="definition__entry">
      <h2 id="definition-title" class="definition__word">
        <span class="display">ha·mon</span>
        <span class="meta">hah-mon · noun · from Japanese 刃文</span>
      </h2>

      <ol class="definition__senses">
        <li data-reveal="fade">
          <span class="definition__n meta" aria-hidden="true">1</span>
          <p class="lede">The line that appears along a blade when it is tempered in fire.</p>
        </li>
        <li data-reveal="fade" style="--i: 2">
          <span class="definition__n meta" aria-hidden="true">2</span>
          <p class="lede">It can’t be painted on. It is earned in the heat, and revealed only by polishing.</p>
        </li>
      </ol>

      <p class="definition__note" data-reveal="fade" style="--i: 4">
        Everything in this volume was made that way: slowly, with nothing added for show, then polished until the line
        came through.
      </p>
    </div>
  </div>

  <HamonLine seed={7} class="definition__hamon" />
</section>

<style>
  .definition {
    padding-block: var(--space-section) 0;
  }

  .definition__grid {
    align-items: start;
  }

  .definition__kanji {
    grid-column: 2 / span 2;
    justify-self: center;
    font-size: clamp(5rem, 3rem + 7vw, 11rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
  }

  .definition__entry {
    grid-column: 5 / span 7;
  }

  .definition__word {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }

  .definition__word .display {
    font-size: clamp(2.75rem, 2rem + 3vw, 5rem);
    font-style: italic;
    font-weight: 300;
    font-stretch: 75%;
  }

  .definition__senses {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .definition__senses li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
  }

  .definition__n {
    color: var(--color-accent-text);
  }

  .definition__note {
    margin: var(--space-7) 0 0 2.5rem;
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .definition :global(.definition__hamon) {
    margin-top: var(--space-section);
  }

  @media (max-width: 47.99rem) {
    .definition__kanji {
      grid-column: 1 / -1;
      justify-self: start;
      writing-mode: horizontal-tb;
      font-size: 4.5rem;
      margin-bottom: var(--space-6);
    }

    .definition__entry {
      grid-column: 1 / -1;
    }

    .definition__senses li {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }

    .definition__note {
      margin-left: 1.75rem;
    }
  }
</style>
