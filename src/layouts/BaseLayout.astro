---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import Masthead from '../components/chrome/Masthead.astro';
import PageRail from '../components/chrome/PageRail.astro';
import ContentsDialog from '../components/chrome/ContentsDialog.astro';
import Colophon from '../components/chrome/Colophon.astro';
import { site } from '../data/site';
import { profileLinks } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
  /** Running head shown in the masthead before any chapter has scrolled in. */
  running?: { label: string; title: string };
  /** Adds Person structured data (the homepage). */
  person?: boolean;
}

const { title, description = site.description, running = { label: 'Prologue', title: 'Every line is final' }, person = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const sameAs = profileLinks()
  .filter((l) => l.me)
  .map((l) => l.href);
const personLd = person
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      description: site.statement,
      address: { '@type': 'PostalAddress', addressLocality: site.location.city },
      ...(Astro.site ? { url: Astro.site.href } : {}),
      ...(sameAs.length ? { sameAs } : {}),
    })
  : null;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ebe4d6" />
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href="/sitemap.xml" />}
    <meta property="og:type" content={person ? 'profile' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A vermilion sun split by a brush stroke above a lone swordsman, with the words Every line is final." />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {personLd && <script type="application/ld+json" set:html={personLd} />}
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-jp" />
    <script is:inline>
      // Enable reveal states only when scripting is available; content never depends on it.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead label={running.label} title={running.title} />
    <PageRail />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Colophon />
    <ContentsDialog />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
