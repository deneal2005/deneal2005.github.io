---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/ui/Plate.astro';
import Arrow from '../../components/ui/Arrow.astro';
import HamonLine from '../../components/motifs/HamonLine.astro';
import { formatDate, getJourney, getWorks, journeyHref } from '../../lib/content';
import { plates, plateSize, plateUrl } from '../../lib/plates';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, next: works[(i + 1) % works.length], total: works.length },
  }));
}

interface Props {
  work: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
  total: number;
}

const { work, next, total } = Astro.props;
const { data } = work;
const { Content, headings } = await render(work);
const number = String(data.order).padStart(2, '0');
const isFinal = data.order === total;
const related = (await getJourney()).filter((entry) => entry.data.project?.id === work.id);

const plate = plates[data.plate];
const cover = { src: plateUrl(data.plate, 'a'), ...plateSize(plate, 'a') };
const detail = { src: plateUrl(data.plate, 'b'), ...plateSize(plate, 'b') };
const landscape = cover.width > cover.height;
const nextCover = { src: plateUrl(next.data.plate, 'a'), ...plateSize(plates[next.data.plate], 'a') };

const meta = [
  { label: 'What', value: data.kind },
  { label: 'Year', value: String(data.year) },
  { label: 'Status', value: data.status },
  data.role && { label: 'Role', value: data.role },
].filter((m): m is { label: string; value: string } => Boolean(m));
---

<BaseLayout
  title={data.title}
  description={data.summary}
  running={{ label: `Chapter 03 · ${number}`, title: data.title }}
>
  <article class="case" data-chapter-label={`Chapter 03 · ${number}`} data-chapter-title={data.title} aria-labelledby="case-title">
    <header class="case__head wrap">
      <div class="case__trail">
        <a class="case__back meta" href="/#work"><Arrow dir="left" /> The Work</a>
        <p class="meta">Chapter 03 · {number} of {String(total).padStart(2, '0')}</p>
      </div>

      <p class="case__kind meta"><span class="case__no">{number}</span> {data.kind} · {data.year} · {data.status}</p>
      <h1 id="case-title" class="case__title display" data-reveal="rise">
        {
          data.titleLines.map((line, i) => (
            <span class="rise" style={`--line: ${i}`}>
              <span>{line}</span>
            </span>
          ))
        }
      </h1>
      <div class="case__intro">
        <p class="case__summary lede" data-reveal="fade" style="--i: 3">{data.summary}</p>
        {
          (data.links.live || data.links.repo || data.links.other.length > 0) && (
            <p class="case__actions" data-reveal="fade" style="--i: 5">
              {data.links.live && (
                <a class="btn btn--ink" href={data.links.live} target="_blank" rel="noopener">
                  Visit the live site <Arrow dir="out" />
                  <span class="vh">(opens in a new tab)</span>
                </a>
              )}
              {data.links.repo && (
                <a class="btn" href={data.links.repo} target="_blank" rel="noopener">
                  Source on GitHub <Arrow dir="out" />
                  <span class="vh">(opens in a new tab)</span>
                </a>
              )}
              {data.links.other.map((link) => (
                <a class="btn" href={link.href} target="_blank" rel="noopener">
                  {link.label} <Arrow dir="out" />
                  <span class="vh">(opens in a new tab)</span>
                </a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class:list={['case__cover', landscape ? 'case__cover--wide' : 'case__cover--tall']}>
      <Plate src={cover.src} alt={data.alt} width={cover.width} height={cover.height} transitionName={`plate-${work.id}`} eager reveal={false} />
    </div>

    <div class="case__body wrap">
      <aside class="case__aside">
        <dl class="case__meta">
          {
            meta.map((item) => (
              <div>
                <dt class="meta">{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
          <div>
            <dt class="meta">Stack</dt>
            <dd>
              <ul class="case__stack">
                {data.stack.map((term) => (
                  <li>{term}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
        {
          headings.some((h) => h.depth === 2) && (
            <nav class="case__toc" aria-label="On this page">
              <p class="meta">On this page</p>
              <ol>
                {data.features.length > 0 && (
                  <li>
                    <a class="link" href="#features">
                      Key features
                    </a>
                  </li>
                )}
                {headings
                  .filter((h) => h.depth === 2)
                  .map((h) => (
                    <li>
                      <a class="link" href={`#${h.slug}`}>
                        {h.text}
                      </a>
                    </li>
                  ))}
              </ol>
            </nav>
          )
        }
      </aside>

      <div class="case__main">
        {
          data.features.length > 0 && (
            <section class="case__features" aria-labelledby="features">
              <h2 id="features" class="case__features-title meta">
                Key features
              </h2>
              <ol>
                {data.features.map((feature, i) => (
                  <li>
                    <span class="case__feature-n meta" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        <div class="longform">
          <Content />
        </div>
      </div>
    </div>

    {
      data.screens.length > 0 && (
        <section class="case__screens wrap" aria-label="Screenshots">
          {data.screens.map((screen) => {
            const phone = screen.src.height > screen.src.width;
            return (
              <figure class:list={['case__screen', phone ? 'case__screen--phone' : 'case__screen--wide']}>
                <Image
                  src={screen.src}
                  alt={screen.alt}
                  widths={phone ? [390, 780] : [800, 1440, 2160]}
                  sizes={phone ? '(min-width: 64rem) 22vw, 70vw' : '(min-width: 64rem) 66vw, 100vw'}
                />
                {screen.caption && <figcaption class="meta">{screen.caption}</figcaption>}
              </figure>
            );
          })}
        </section>
      )
    }

    <figure class="case__detail wrap">
      <Plate src={detail.src} alt={data.detailAlt} width={detail.width} height={detail.height} />
      <figcaption class="meta">Detail · Plate {number}, enlarged</figcaption>
    </figure>

    {
      related.length > 0 && (
        <section class="case__related wrap" aria-labelledby="related-title">
          <h2 id="related-title" class="meta">
            In the journey
          </h2>
          <ol>
            {related.map((entry) => (
              <li>
                <a class="case__related-link" href={journeyHref(entry)}>
                  <time class="meta" datetime={entry.data.date.toISOString().slice(0, 10)}>
                    {formatDate(entry.data.date)}
                  </time>
                  <span class="case__related-title">{entry.data.title}</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <HamonLine seed={data.order * 5} class="case__hamon" />

    {
      total > 1 && (
        <nav class="case__next wrap" aria-label="Next project">
          <a class="next" href={`/work/${next.id}/`} data-astro-prefetch data-cursor="Turn">
            <span class="next__label meta">
              {isFinal ? 'Back to the first project' : 'Next project'} · {String(next.data.order).padStart(2, '0')}
            </span>
            <span class="next__title display">{next.data.title}</span>
            <span class="next__summary">{next.data.summary}</span>
            <span class="next__plate">
              <img
                src={nextCover.src}
                alt=""
                width={nextCover.width}
                height={nextCover.height}
                loading="lazy"
                decoding="async"
                style={`view-transition-name: plate-${next.id}`}
              />
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .case {
    padding-top: calc(var(--masthead-h) + var(--space-6));
  }

  .case__trail {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--panel-border) solid var(--color-rule-strong);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    margin-block: -0.75rem;
    color: var(--color-text);
  }

  @media (hover: hover) {
    .case__back:hover .arrow {
      transform: translateX(-0.3rem);
    }
  }

  .case__kind {
    margin-top: var(--space-8);
  }

  .case__no {
    color: var(--color-accent-text);
    margin-right: var(--space-2);
  }

  .case__title {
    margin-top: var(--space-4);
    font-size: clamp(3.75rem, 1.5rem + 9vw, 12rem);
    font-weight: 350;
    text-transform: uppercase;
  }

  .case__intro {
    margin: var(--space-6) 0 0 auto;
    max-width: 40rem;
  }

  .case__summary {
    font-style: italic;
  }

  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .case__actions .arrow--out {
    width: 0.8rem;
    height: 0.62rem;
  }

  /* ── Cover ─────────────────────────────────────────── */
  .case__cover {
    margin-top: var(--space-8);
  }

  .case__cover--wide :global(.plate) {
    max-height: 88svh;
    width: 100%;
  }

  .case__cover--tall {
    padding-inline: var(--margin);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .case__cover--tall :global(.plate) {
    grid-column: 4 / 10;
  }

  /* ── Body ──────────────────────────────────────────── */
  .case__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    margin-top: var(--space-section);
    align-items: start;
  }

  .case__aside {
    grid-column: 1 / span 4;
    position: sticky;
    top: calc(var(--masthead-h) + var(--space-5));
    display: grid;
    gap: var(--space-7);
  }

  .case__meta {
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-s);
  }

  .case__meta > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .case__meta dd {
    margin: 0;
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .case__toc ol {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-s);
  }

  .case__main {
    grid-column: 6 / -1;
    display: grid;
    gap: var(--space-8);
  }

  .case__features {
    max-width: 40rem;
  }

  .case__features-title {
    padding-bottom: var(--space-3);
    border-bottom: var(--panel-border) solid var(--color-rule-strong);
    scroll-margin-top: calc(var(--masthead-h) + var(--space-5));
  }

  .case__features ol {
    display: grid;
  }

  .case__features li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .case__feature-n {
    color: var(--color-accent-text);
  }

  /* ── Screens & detail ─────────────────────────────── */
  /* Desktop captures run wide; phone captures sit beside them, at phone scale. */
  .case__screens {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-8);
    margin-top: var(--space-section);
    align-items: start;
  }

  .case__screen--wide {
    grid-column: 1 / span 9;
  }

  .case__screen--wide:nth-of-type(odd) {
    grid-column: 4 / -1;
  }

  .case__screen--phone {
    grid-column: span 3;
  }

  .case__screens :global(img) {
    width: 100%;
    height: auto;
    border: var(--panel-border) solid var(--color-rule-strong);
  }

  .case__screen--phone :global(img) {
    border-radius: 1.5rem;
  }

  .case__screens figcaption {
    margin-top: var(--space-3);
  }

  @media (max-width: 63.99rem) {
    .case__screen--wide,
    .case__screen--wide:nth-of-type(odd) {
      grid-column: 1 / -1;
    }

    .case__screen--phone {
      grid-column: 2 / span 10;
      max-width: 22rem;
      justify-self: center;
    }
  }

  .case__detail {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin-top: var(--space-section);
  }

  .case__detail :global(.plate),
  .case__detail figcaption {
    grid-column: 5 / -1;
  }

  .case__detail figcaption {
    margin-top: var(--space-3);
  }

  .case__related {
    margin-top: var(--space-section);
  }

  .case__related h2 {
    padding-bottom: var(--space-3);
    border-bottom: var(--panel-border) solid var(--color-rule-strong);
  }

  .case__related-link {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
  }

  .case__related-title {
    font-family: var(--type-display);
    font-size: var(--text-m);
    font-stretch: 85%;
  }

  @media (hover: hover) {
    .case__related-link:hover .case__related-title {
      color: var(--color-accent-text);
    }

    .case__related-link:hover .arrow {
      transform: translateX(0.25rem);
    }
  }

  .case :global(.case__hamon) {
    margin-top: var(--space-section);
    padding-inline: var(--margin);
  }

  /* ── Next project ─────────────────────────────────── */
  .case__next {
    padding-block: var(--space-8) var(--space-section);
  }

  .next {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-3);
    align-items: end;
  }

  .next__label {
    grid-column: 1 / span 6;
    color: var(--color-text);
  }

  .next__title {
    grid-column: 1 / span 7;
    font-size: var(--text-xl);
    text-transform: uppercase;
    transition: color var(--dur-1) linear;
  }

  .next__summary {
    grid-column: 1 / span 5;
    color: var(--color-text-muted);
    font-size: var(--text-s);
  }

  .next__plate {
    grid-column: 9 / -1;
    grid-row: 1 / span 3;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--washi-deep);
  }

  .next__plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s var(--ease-out);
  }

  @media (hover: hover) {
    .next:hover .next__title {
      color: var(--enji);
    }

    .next:hover .next__plate img {
      scale: 1.05;
    }
  }

  @media (max-width: 63.99rem) {
    .case__cover--tall :global(.plate),
    .case__aside,
    .case__main,
    .case__detail :global(.plate),
    .case__detail figcaption {
      grid-column: 1 / -1;
    }

    .case__aside {
      position: static;
    }

    .next__label,
    .next__title,
    .next__summary,
    .next__plate {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .next__plate {
      order: -1;
      margin-bottom: var(--space-4);
    }
  }

  @media (max-width: 47.99rem) {
    /* On a phone the sections are a thumb-scroll apart; the in-page index is noise */
    .case__toc {
      display: none;
    }

    .case__body {
      margin-top: var(--space-8);
      row-gap: var(--space-7);
    }

    .case__related-link {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .case__related-link time {
      grid-column: 1 / -1;
    }
  }
</style>
